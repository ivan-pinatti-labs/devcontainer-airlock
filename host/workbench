#!/bin/bash
: '
  Build, start and enter the workbench and its helpers. Runs on the host, and
  does nothing there but call podman. docs/LAYERS.md explains the layers.

  Usage:
    host/workbench build            build every image locally (localhost/*:local)
    host/workbench pull             or take the published ones instead, and tag
                                    them as the local ones
    host/workbench init [DIR]       set up a repository for the workbench: its
                                    egress sets, an L2 image, the make targets
    host/workbench up [WORKSPACE]   start the workbenches, one per agent, and
                                    the L2 engine, and the shared services
                                    (helpers, egress proxy, package mirror)
                                    that are not running yet
    host/workbench unlock           add the ssh key to the agent for 8 hours
    host/workbench claude [WORKSPACE]
    host/workbench codex [WORKSPACE]
                                    that agent, in its workbench, in the
                                    folder you are in
    host/workbench claude-<account> [WORKSPACE]
                                    the same, logged in as another account
                                    (WORKBENCH_ACCOUNTS below)
    host/workbench remote claude[-<account>] [WORKSPACE]
                                    claude --remote-control there, to pair
                                    with a device
    host/workbench shell claude|codex[-<account>] [WORKSPACE]
                                    a shell in that agent workbench
    host/workbench load-l2 [WORKSPACE]
                                    copy the local L2 images into the shared L2
                                    store now (up does it when they differ)
    host/workbench status           what is running
    host/workbench down [WORKSPACE] stop that workspace (its workbenches,
                                    engine and network) and take it off the
                                    egress proxy. When no other workspace is
                                    running, the shared services stop too
                                    (their caches stay), which drops the
                                    unlocked ssh key
    host/workbench helpers          start only the helpers (proxy, broker,
                                    ssh-agent); what the login unit runs
    host/workbench helpers-down     stop the shared helpers, which drops the
                                    unlocked ssh key and cuts every workspace
                                    off the network
    host/workbench restart-broker   restart the gh broker alone (after
                                    rebuilding it), keeping the unlocked key
    host/workbench restart-proxy    restart the egress proxy alone (after
                                    rebuilding it); every workspace is cut
                                    off for the few seconds it takes
    host/workbench install-units    install a systemd user unit that starts
                                    the helpers at login (changes your
                                    ~/.config/systemd/user; run it yourself)

  Each agent has a workbench of its own (workbench-claude-<name>,
  workbench-codex-<name>), holding its own login and not the other one, so
  neither agent can read the other credentials. Both share the workspace L2
  engine, egress proxy and helpers. WORKBENCH_AGENTS limits which start
  (default: claude codex). For the editor, attach VS Code to the one whose
  agent extension you want; its title bar says which it is.

  WORKSPACE is the folder mounted into the workbench and the L2 engine, at its
  own path. Default: the main clone of the git repository you are in (so its
  worktrees are included), else the current directory. A single worktree
  works too, for a clone whose other folders hold data that must not be
  relabelled; its git directory is then mounted as well. A repository that
  holds such data marks itself with .devcontainer/workbench-worktree-only,
  and then the worktree you are in is the default, and its main clone is
  refused. Workspaces live under
  WORKBENCH_ROOT (default: the folder holding this clone), which the gh
  broker sees read only, so gh finds the repository a command ran in.

  A workspace can opt in to more for its L2 engine, by listing profile names
  in .devcontainer/workbench-profile (one per line), read from the checkout
  `up` runs in (a worktree counts), else from the workspace. Only the names below are
  understood; anything else stops `up`, so a repository cannot pass arbitrary
  flags to podman on the host:
    nested-network   L2 containers get a bridge network of their own, so a
                      test suite can start containers that reach each other
    hooks-engine     pre-commit runs get the engine too (l2 --engine), for
                      hooks that build or start containers; nothing on the
                      host side
    nested-devices   L2 containers may be given /dev/fuse and /dev/net/tun.
                      Needs the host SELinux module in host/selinux/, which
                      only root can install (docs/IMAGES.md)

  Each workspace has its own internal network, 10.203.N.0/24. One egress
  proxy serves them all: it sits at .2 on each, and allows a workspace the
  egress sets its checkout lists in .devcontainer/egress-sets, one name per
  line (default: python, node), plus workbench, github and ghcr, which are
  always on, and ubuntu and nodesource when the checkout has an L2 image of
  its own to build (.devcontainer/l2/Dockerfile). A request is matched to a
  workspace by the network it comes from, so one workspace never gets the
  sets of another. `up` registers the workspace (again, so a changed file
  takes effect) and `down` takes it off, each with a reload that leaves the
  connections of the other workspaces open. Restarting the proxy cuts every
  workspace off for a moment. `podman run --rm
  localhost/airlock-egress-proxy egress-refresh --list` shows every set.

  Unless WORKBENCH_MIRROR=0, a package mirror runs beside the proxy, one for
  the host: its gate at .254 on each workspace network, which L2 and the
  engine install and pull through, and its backend (Nexus Repository CE) on
  a network of its own, whose only way out is the proxy. The gate leaves
  out npm, PyPI and Go versions listed as malicious in OSV. A workspace
  whose .devcontainer/egress-sets lists mirror (and nothing else) reaches no
  registry but through it. docs/LAYERS.md, Package mirror.

  Settings, from the environment or ${XDG_CONFIG_HOME}/workbench/config
  (KEY=value lines, read and never run; the environment wins):
    WORKBENCH_GH_OWNERS   the GitHub owners (users or organizations) the gh
                          broker may act on, comma separated. Required
    WORKBENCH_GH_SECRET   the podman secret holding the GitHub token.
                          Default: gh-devcontainer
    WORKBENCH_SSH_KEY     the private key the ssh-agent holds, best one made
                          for this alone. Default: ~/.ssh/devcontainer/id_ed25519
    WORKBENCH_ROOT        the folder every workspace lives under (above)
    WORKBENCH_AGENTS      which workbenches `up` starts. Default: claude codex
    WORKBENCH_ACCOUNTS    more logins for the agents, space separated (say,
                          personal): claude-personal and codex-personal are
                          workbenches of their own, with their own login
    WORKBENCH_HISTORY     share Claude Code session history with the host,
                          as <workbench>=<host config folder> pairs, space
                          separated (say, claude=~/.claude
                          claude-personal=~/.claude-personal). Only the
                          history of the workspace path and the paths
                          under it; settings, hooks and logins stay apart
    WORKBENCH_TAG         the local image tag. Default: local
    WORKBENCH_VOICE       1 to give a Claude session (claude, or remote) the
                          host microphone for voice mode, push to talk: it is
                          routed only while Claude Code records. Default: off;
                          the make targets turn it on (make claude-plain does
                          not). Needs pactl on the host
    WORKBENCH_TZ          the time zone of the workbenches, as podman --tz
                          takes it (America/Toronto, say). Default: local,
                          the host one; L2 stays on UTC
    WORKBENCH_MIRROR      0 to run without the package mirror (docs/LAYERS.md,
                          Package mirror), through which installs and image
                          pulls in L2 and the engine go. Default: 1, on
    WORKBENCH_MIRROR_MIN_AGE
                          hide npm and Go versions published fewer days ago
                          than this. Default: 0, off
    WORKBENCH_MIRROR_HEAP the Java heap of the mirror backend, in MB. Default: 1024
    WORKBENCH_REGISTRY    where `pull` takes images from, with
                          WORKBENCH_PULL_TAG (default: latest).
                          Default: ghcr.io/ivan-pinatti-labs

  State kept on the host:
    ${XDG_DATA_HOME}/workbench/claude, codex  the agents logins and settings,
        separate from your own ~/.claude and ~/.codex
    ${XDG_RUNTIME_DIR}/workbench/gh           the gh broker socket
    ${XDG_RUNTIME_DIR}/workbench/egress       the workspaces the egress proxy
                                              serves, and their sets
    ${XDG_RUNTIME_DIR}/workbench/mirror       the workspaces the package mirror
                                              serves, and the registry mirror
                                              settings of their engines
    ${XDG_RUNTIME_DIR}/workbench/<name>       the L2 engine socket
    ${XDG_RUNTIME_DIR}/devcontainer-ssh       the ssh-agent socket, known_hosts
    ${XDG_RUNTIME_DIR}/workbench/voice/<name> the microphone pipe of a voice
                                              session, only while it runs
    podman volume l2-engine-<name>            L2 images, pre-commit caches
    podman volume egress-cache                providers last good lists
    podman volumes mirror-*                   the mirror cache, its OSV
                                              feeds and its admin password

  Exit status codes:
    1  a prerequisite is missing (the message says which)
    2  usage error
'

set -o errexit
set -o nounset
set -o pipefail

# Git's repository variables, inherited from a hook or a wrapper, would point
# every git call below at that repository instead of the checkout asked about,
# and could walk a marked main clone past the worktree-only guard.
unset GIT_DIR GIT_COMMON_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_OBJECT_DIRECTORY GIT_NAMESPACE GIT_CEILING_DIRECTORIES

die() { echo "workbench: $*" >&2; exit 1; }

# Settings, from the environment or from this file as KEY=value lines (the
# environment wins). The file is read, never sourced, so it cannot run
# anything, and only the names below are accepted.
CONFIG="${XDG_CONFIG_HOME:-${HOME}/.config}/workbench/config"
load_config() {
  local key value
  [ -f "${CONFIG}" ] || return 0
  while IFS='=' read -r key value || [ -n "${key}" ]; do
    case "${key}" in
      '' | '#'*) continue ;;
      WORKBENCH_ROOT | WORKBENCH_TAG | WORKBENCH_TZ | WORKBENCH_VOICE | WORKBENCH_AGENTS | WORKBENCH_ACCOUNTS | WORKBENCH_HISTORY | WORKBENCH_GH_OWNERS | WORKBENCH_GH_SECRET | WORKBENCH_SSH_KEY | WORKBENCH_REGISTRY | WORKBENCH_MIRROR | WORKBENCH_MIRROR_MIN_AGE | WORKBENCH_MIRROR_HEAP) ;;
      *) die "unknown setting '${key}' in ${CONFIG}" ;;
    esac
    # Set in the environment, even to nothing, wins over the file.
    [[ -v "${key}" ]] || printf -v "${key}" '%s' "${value}"
  done < "${CONFIG}"
}
load_config

TAG="${WORKBENCH_TAG:-local}"
BASE="localhost/airlock-base:${TAG}"
# One workbench image per agent, built from the same Dockerfile.
wb_image() { echo "localhost/airlock-workbench-$1:${TAG}"; }
# Every agent there is a workbench for, and the ones `up` starts.
KNOWN_AGENTS="claude codex"
AGENTS="${WORKBENCH_AGENTS:-${KNOWN_AGENTS}}"
# More logins for the same agents (a second subscription, say): claude-<name>
# is Claude Code in a workbench of its own, with its own login folder.
WORKBENCH_ACCOUNTS="${WORKBENCH_ACCOUNTS:-}"
ACCOUNTS="${WORKBENCH_ACCOUNTS//,/ }"

# Claude Code session history shared with the host (WORKBENCH_HISTORY): the
# host's projects/<path> folders for this workspace and the paths under it,
# mounted into the workbench's own projects folder. Transcripts and memory
# only: settings.json, whose hooks run on the host, and the login stay apart.
# The folder for the workspace itself is created first, so sessions started
# there are shared from the first one.
# Whether every path on stdin is $1 or under it, each normalized first
# (realpath -m -s: no .. or . left, nothing needs to exist), so a recorded
# /workspace/../sibling does not pass as under /workspace.
all_under() {
  local p base
  base="$(realpath -m -s -- "$1")"
  while read -r p; do
    p="$(realpath -m -s -- "${p}")" || return 1
    case "${p}/" in "${base}"/*) ;; *) return 1 ;; esac
  done
}

history_mounts() {
  local ws="$1" agent="$2" pair host slug d cwd
  [ "$(agent_of "${agent}")" = claude ] || return 0
  for pair in ${WORKBENCH_HISTORY:-}; do
    [ "${pair%%=*}" = "${agent}" ] || continue
    host="${pair#*=}"
    host="${host/#\~/${HOME}}/projects"
    [ -d "${host}" ] || die "WORKBENCH_HISTORY: no ${host}"
    slug="$(printf '%s' "${ws}" | tr -c 'A-Za-z0-9' -)"
    [ -e "${host}/${slug}" ] || mkdir -p "${host}/${slug}"
    for d in "${host}/${slug}" "${host}/${slug}"-*; do
      [ -d "${d}" ] || continue
      # The name encodes a path ambiguously (/work/foo-bar and /work/foo/bar
      # both become -work-foo-bar, even the workspace's own), so a folder with
      # transcripts is mounted only when every working directory they record
      # is the workspace or under it. One with none yet is mounted only when
      # it is the workspace's own, so its first session reaches the host.
      # A folder with no transcripts yet makes grep fail; that is an answer
      # (none recorded), not an error.
      cwd="$({ grep -h -o '"cwd":"[^"]*"' "${d}"/*.jsonl 2>/dev/null || true; } | sed 's/^"cwd":"//; s/"$//' | sort -u)"
      if [ -z "${cwd}" ]; then
        [ "$(basename "${d}")" = "${slug}" ] || continue
      elif ! all_under "${ws}" <<<"${cwd}"; then
        continue
      fi
      printf '%s\n' -v "$(readlink -f "${d}"):/home/dev/.claude/projects/$(basename "${d}"):Z"
    done
  done
  return 0
}

# The agent a workbench runs (claude for claude-personal), and whether a name
# is a workbench there can be: an agent, or an agent and one of the accounts.
agent_of() { echo "${1%%-*}"; }
valid_agent() {
  local base="${1%%-*}" account="${1#*-}"
  case " ${KNOWN_AGENTS} " in *" ${base} "*) ;; *) return 1 ;; esac
  [ "$1" = "${base}" ] && return 0
  case " ${ACCOUNTS} " in *" ${account} "*) return 0 ;; esac
  return 1
}
L2_IMAGE="localhost/airlock-l2:${TAG}"
ENGINE_IMAGE="localhost/airlock-l2-engine:${TAG}"
BROKER_IMAGE="localhost/airlock-gh-broker:${TAG}"
PROXY_IMAGE="localhost/airlock-egress-proxy:${TAG}"
GATE_IMAGE="localhost/airlock-mirror-gate:${TAG}"
# The mirror backend, Nexus Repository Community Edition, pinned by digest.
# Its gate (above) is the only part clients know, so another backend is
# another routes file and provisioning under images/mirror-gate/backends/.
# renovate: datasource=docker depName=docker.io/sonatype/nexus3
NEXUS_IMAGE="docker.io/sonatype/nexus3:3.96.3@sha256:a406f4e9dc149e050723a93bf57964311f6d1c88e1dcbed2e42ea373319a1772"
MIRROR="${WORKBENCH_MIRROR:-1}"
MIRROR_NET=workbench-net-airlock-mirror
# The one egress proxy of the host, shared by every workspace.
PROXY=egress-proxy

# Egress sets every workspace gets when it names none of its own; workbench,
# github and ghcr are always added by the proxy itself.
DEFAULT_SETS=python,node
# Every container that talks over a socket to another runs in the same SELinux
# domain and category, or the connection is refused.
# shellcheck disable=SC2054 # the comma is inside the SELinux level
LABEL_OPTS=(--security-opt label=type:container_engine_t --security-opt label=level:s0:c555,c666)

DATA="${XDG_DATA_HOME:-${HOME}/.local/share}/workbench"
RUN="${XDG_RUNTIME_DIR:?XDG_RUNTIME_DIR is not set}"
GH_DIR="${RUN}/workbench/gh"
# The workspaces the egress proxy serves, one file each, which it reads.
EGRESS_DIR="${RUN}/workbench/egress"
MIRROR_DIR="${RUN}/workbench/mirror"
SSH_DIR="${RUN}/devcontainer-ssh"
# Per Claude workbench, the folder a voice session's microphone pipe appears
# in (docs/LAYERS.md, Voice).
VOICE_ROOT="${RUN}/workbench/voice"
# The key the ssh-agent holds, the podman secret holding the GitHub token, and
# the GitHub owners the broker may act on.
SSH_KEY="${WORKBENCH_SSH_KEY:-${HOME}/.ssh/devcontainer/id_ed25519}"
GH_SECRET="${WORKBENCH_GH_SECRET:-gh-devcontainer}"
GH_OWNERS="${WORKBENCH_GH_OWNERS:-}"
# Where `pull` takes prebuilt images from.
REGISTRY="${WORKBENCH_REGISTRY:-ghcr.io/ivan-pinatti-labs}"
HERE="$(cd "$(dirname "$0")/.." && pwd)"
# The folder holding this repository's main clone, even when this script runs
# from one of its worktrees.
MAIN="$(dirname "$(git -C "${HERE}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || echo "${HERE}/.git")")"
ROOT="${WORKBENCH_ROOT:-$(dirname "${MAIN}")}"

running() { [ "$(podman inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" = true ]; }

# `up` and `down` one at a time, so a `down` that finds no workspace left
# cannot stop the shared services under an `up` that is starting one.
# Released before anything long lived (podman exec) inherits it.
lock_state() {
  mkdir -p "${RUN}/workbench"
  exec 9>"${RUN}/workbench/lock"
  flock 9
}
unlock_state() { exec 9>&-; }

# Two workspaces with the same folder name would map to the same container
# names. Each container carries its workspace in a label; refuse to reuse one
# that belongs to a different path.
check_owner() {
  local name="$1" label="$2" ws="$3" owner
  owner="$(podman inspect -f "{{index .Config.Labels \"${label}\"}}" "${name}" 2>/dev/null)" || return 0
  [ -z "${owner}" ] || [ "${owner}" = "${ws}" ] \
    || die "${name} belongs to ${owner}, another folder of the same name; stop it first (host/workbench down ${owner})"
}

# Whether $1 is a repository's main checkout rather than one of its linked
# worktrees: its own git directory is the common one. This holds whatever
# form its .git takes (a directory, or a file for a submodule or a
# --separate-git-dir clone).
is_main_checkout() {
  local own common
  own="$(git -C "$1" rev-parse --path-format=absolute --git-dir 2>/dev/null)" || return 1
  common="$(git -C "$1" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 1
  [ "${own}" = "${common}" ]
}

# Whether a repository is developed from worktrees only: the marker in its
# checkout, or on its remote's default branch, so a main clone that has not
# pulled since the marker landed still counts.
is_worktree_only() {
  local r="$1" m=.devcontainer/workbench-worktree-only ref
  [ -f "${r}/${m}" ] && return 0
  for ref in origin/HEAD origin/main; do
    git -C "${r}" cat-file -e "${ref}:${m}" 2>/dev/null && return 0
  done
  return 1
}

# A multi-repository workspace: a folder that is not itself in a git checkout
# and holds clones side by side, an organization's repositories for instance,
# for work that spans them.
is_group() {
  ! git -C "$1" rev-parse --git-dir >/dev/null 2>&1 && [ -n "$(group_repos "$1")" ]
}

# The main checkouts directly under a group folder.
group_repos() {
  local d
  for d in "$1"/*/; do
    d="${d%/}"
    if is_main_checkout "${d}"; then echo "${d}"; fi
  done
}

# Where a group workspace keeps its state: named for the folder, and for its
# full path, so two groups whose folders share a name never share state.
group_state() {
  echo "${DATA}/groups/$(slug "$1")-$(printf '%s' "$1" | sha256sum | cut -c1-12)"
}

# What a workspace mounts (and the git settings that go with it), as podman
# arguments, each path at its own path. A
# single checkout is mounted whole, with its git directory when that lives
# elsewhere. A group mounts each clone on its own, so nothing else in the
# folder is relabelled: a worktree only clone brings only its git directory
# and its worktrees, never the data its main clone holds, and the folder's
# own agent files come along.
ws_mounts() {
  local ws="$1" r f n=0
  if ! is_group "${ws}"; then
    printf '%s\n' -v "${ws}:${ws}:Z"
    git_dir_mount "${ws}"
    return 0
  fi
  # The folder itself is backed by a directory kept with the workbench's
  # state, with the clones mounted on top of it: it has to be writable, since
  # Claude Code's command sandbox creates a placeholder there for every file
  # it guards (.gitconfig, .npmrc, .bashrc and more) before binding over it,
  # and the real folder cannot be mounted without relabelling everything in
  # it. What is created at the root lives there, not in the folder.
  f="$(group_state "${ws}")/root"
  mkdir -p "${f}"
  printf '%s\n' -v "${f}:${ws}:Z"
  while read -r r; do
    if is_worktree_only "${r}"; then
      mkdir -p "${r}/.claude/worktrees"
      printf '%s\n' -v "${r}/.git:${r}/.git:Z" -v "${r}/.claude/worktrees:${r}/.claude/worktrees:Z"
      # Its folder in the container is only the parent of those two mounts,
      # owned by root, and git refuses a repository it does not own unless
      # told it is safe. Said for exactly these repositories, no others.
      printf '%s\n' -e "GIT_CONFIG_KEY_${n}=safe.directory" -e "GIT_CONFIG_VALUE_${n}=${r}"
      n=$((n + 1))
    else
      printf '%s\n' -v "${r}:${r}:Z"
    fi
  done < <(group_repos "${ws}")
  if [ "${n}" -gt 0 ]; then printf '%s\n' -e "GIT_CONFIG_COUNT=${n}"; fi
  for f in CLAUDE.md AGENTS.md CLAUDE.local.md .claude; do
    if [ -e "${ws}/${f}" ]; then printf '%s\n' -v "${ws}/${f}:${ws}/${f}:Z"; fi
  done
  # Claude Code's command sandbox guards <workdir>/.mcp.json by binding over
  # it, so the file has to exist, and the group folder itself is not a mount
  # (only the clones in it are): nothing can be created there, and without
  # this every command in that sandbox fails. The folder's own .mcp.json is mounted
  # when it has one, else an empty server list kept with the workbench's
  # state, never written into the folder. Read only either way, so nothing
  # in a workbench can add a server to it.
  if [ -e "${ws}/.mcp.json" ]; then
    printf '%s\n' -v "${ws}/.mcp.json:${ws}/.mcp.json:ro,Z"
  else
    f="$(group_state "${ws}")/.mcp.json"
    mkdir -p "$(dirname "${f}")"
    [ -f "${f}" ] || printf '{"mcpServers":{}}\n' > "${f}"
    printf '%s\n' -v "${f}:${ws}/.mcp.json:ro,Z"
  fi
}

workspace() {
  local w="${1:-}" top common
  if [ -z "${w}" ]; then
    if common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
      w="$(dirname "${common}")"
    else
      w="${PWD}"
    fi
  fi
  w="$(cd "${w}" && pwd)"
  # A repository whose main clone holds data other containers use (a running
  # stack's volumes, say) marks itself worktree only, in its main clone or in
  # the checkout you are in: its workspace is then that worktree, and never
  # the main clone, which up would relabel under those containers.
  top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  if is_main_checkout "${w}" && { is_worktree_only "${w}" \
    || { [ -n "${top}" ] && is_worktree_only "${top}"; }; }; then
    if [ -z "${1:-}" ] && [ -n "${top}" ] && [ "${top}" != "${w}" ]; then
      w="${top}"
    else
      die "${w} is developed from worktrees only (.devcontainer/workbench-worktree-only): its main clone holds data other containers use. Run this from a worktree, git -C ${w} worktree add .claude/worktrees/<name>"
    fi
  fi
  echo "${w}"
}

# A workspace's name: the folder's own name, or <clone>-<worktree> for a
# worktree under a clone's .claude/worktrees, so two repositories' worktrees
# of the same name never share containers.
slug() {
  local name
  case "$1" in
    */.claude/worktrees/*) name="$(basename "${1%%/.claude/worktrees/*}")-$(basename "$1")" ;;
    *) name="$(basename "$1")" ;;
  esac
  printf '%s\n' "${name}" | tr -c 'A-Za-z0-9_.\n-' _
}
# The workbench of agent $2 for workspace $1.
wb_name() { echo "workbench-$2-$(slug "$1")"; }
engine_name() { echo "l2-engine-$(slug "$1")"; }
engine_dir() { echo "${RUN}/workbench/$(slug "$1")"; }
net_name() { echo "workbench-net-$(slug "$1")"; }

# Each workspace has an internal network of its own, 10.203.N.0/24 with N
# picked when the network is first created, and its proxy at .2 on it.
ensure_net() { create_net "$(net_name "$1")"; }
create_net() {
  local net="$1" used n
  podman network exists "${net}" && return
  used="$(podman network ls --format '{{.Name}}' \
    | xargs -r podman network inspect --format '{{range .Subnets}}{{.Subnet}} {{end}}' 2>/dev/null | tr '\n' ' ')"
  for n in $(seq 1 254); do
    case " ${used} " in
      *" 10.203.${n}.0/24 "*) ;;
      *)
        podman network create --internal --disable-dns --subnet "10.203.${n}.0/24" "${net}" >/dev/null
        return ;;
    esac
  done
  die "no free 10.203.N.0/24 subnet left for ${net}"
}

# When the workspace is a single worktree rather than a whole clone (a clone
# whose other folders hold data other containers use, which must not be
# relabelled), its git directory lives outside it: mount just that too.
git_dir_mount() {
  local ws="$1" common
  common="$(git -C "${ws}" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 0
  case "${common}/" in
    "${ws}"/*) ;;
    *) printf '%s\n' "-v" "${common}:${common}:Z" ;;
  esac
}

net_subnet() {
  podman network inspect "$1" --format '{{range .Subnets}}{{.Subnet}}{{end}}'
}
net_proxy_ip() {
  local subnet
  subnet="$(net_subnet "$1")"
  echo "${subnet%.0/24}.2"
}
# The proxy's address on workspace $1's network.
proxy_ip() { net_proxy_ip "$(net_name "$1")"; }

# The proxy variables for a container on this workspace's network, into the
# global PROXY_ENV array.
set_proxy_env() {
  local url plain no="localhost,127.0.0.1" gate
  url="http://$(proxy_ip "$1"):8888"
  plain="${url}"
  if mirror_on; then
    gate="$(mirror_ip "$1")"
    no="${no},${gate}"
    # The engine's plain http (apt, in image builds) goes to the gate, which
    # serves the archives it mirrors and refuses every other host.
    [ "${2:-}" = engine ] && plain="http://${gate}:8081"
  fi
  # shellcheck disable=SC2054 # the commas are inside NO_PROXY's value
  PROXY_ENV=(
    -e HTTPS_PROXY="${url}" -e HTTP_PROXY="${plain}" -e NO_PROXY="${no}"
    -e https_proxy="${url}" -e http_proxy="${plain}" -e no_proxy="${no}"
  )
  if mirror_on; then PROXY_ENV+=(-e AIRLOCK_MIRROR="http://${gate}:8081"); fi
}

# The egress sets this workspace selected in .devcontainer/egress-sets, one
# name per line, comma separated for the proxy. The proxy refuses a name it
# does not know; this only refuses one that could not be a name at all.
egress_sets() {
  local r all="" one
  if is_group "$1"; then
    # A group gets every set its repositories ask for, and the folder's own
    # .devcontainer/egress-sets when it has one. Collected here rather than
    # in a pipeline, so a bad name in any of them fails the whole call.
    if [ -f "$1/.devcontainer/egress-sets" ]; then
      one="$(sets_of "$1")" || return 1
      all="${one}"
    fi
    while read -r r; do
      one="$(group_sets_of "${r}")" || return 1
      all="${all:+${all},}${one}"
    done < <(group_repos "$1")
    printf '%s\n' "${all}" | tr ',' '\n' | awk 'NF && !seen[$0]++' | paste -sd, -
  else
    sets_of "$(profile_source "$1")"
  fi
}

# A file as a group reads it from one of its repositories: the checkout's copy
# and the one on the remote's default branch together, since a main clone may
# not have pulled since its repository last changed it.
repo_file() {
  local ref
  if [ -f "$1/$2" ]; then cat "$1/$2"; fi
  for ref in origin/HEAD origin/main; do
    git -C "$1" show "${ref}:$2" 2>/dev/null && return 0
  done
  return 0
}

# The egress sets one repository of a group asks for, read through repo_file.
group_sets_of() {
  local r="$1" p out=""
  while read -r p; do
    case "${p}" in
      '' | '#'*) ;;
      *[!a-z0-9-]*) die "'${p}' in ${r}/.devcontainer/egress-sets is not an egress set name" ;;
      *) out="${out:+${out},}${p}" ;;
    esac
  done < <(repo_file "${r}" .devcontainer/egress-sets)
  if [ -z "${out}" ]; then out="${DEFAULT_SETS}"; fi
  if [ -n "$(repo_file "${r}" .devcontainer/l2/Dockerfile)" ]; then out="${out},ubuntu,nodesource"; fi
  echo "${out}"
}

# The egress sets one checkout (or a group folder) asks for.
sets_of() {
  local src="$1" f p out=""
  f="${src}/.devcontainer/egress-sets"
  if [ -f "${f}" ]; then
    while read -r p; do
      case "${p}" in
        '' | '#'*) ;;
        *[!a-z0-9-]*) die "'${p}' in ${f} is not an egress set name" ;;
        *) out="${out:+${out},}${p}" ;;
      esac
    done < "${f}"
  else
    out="${DEFAULT_SETS}"
  fi
  # A repository with an L2 image of its own gets it built in the engine by
  # `l2`, and that build installs from Ubuntu's archive and, through the
  # source the shared L2 image enables, NodeSource's.
  [ -f "${src}/.devcontainer/l2/Dockerfile" ] && out="${out:+${out},}ubuntu,nodesource"
  echo "${out}"
}

profile_source() {
  local ws="$1" top
  top="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  case "${top}/" in
    "${ws}"/*) echo "${top}" ;;
    *) echo "${ws}" ;;
  esac
}

profiles() {
  local r p out
  if is_group "$1"; then
    # A group's engine gets every profile its repositories opt in to. Read in
    # this shell, not a pipeline, so an unknown profile in any of them stops
    # the caller rather than one branch of it.
    out="$(profiles_of "$1")" || return 1
    while read -r r; do
      while read -r p; do
        case "${p}" in
          '' | '#'*) ;;
          nested-network | nested-devices | hooks-engine) out="${out}"$'\n'"${p}" ;;
          *) die "unknown profile '${p}' in ${r}/.devcontainer/workbench-profile" ;;
        esac
      done < <(repo_file "${r}" .devcontainer/workbench-profile)
    done < <(group_repos "$1")
    printf '%s\n' "${out}" | awk 'NF' | sort -u
  else
    profiles_of "$(profile_source "$1")"
  fi
}

# The profiles one checkout (or a group folder) opts in to.
profiles_of() {
  local f p
  f="$1/.devcontainer/workbench-profile"
  [ -f "${f}" ] || return 0
  while read -r p; do
    case "${p}" in
      '' | '#'*) ;;
      nested-network | nested-devices | hooks-engine) echo "${p}" ;;
      *) die "unknown profile '${p}' in ${f}" ;;
    esac
  done < "${f}"
}

cmd_build() {
  local i
  podman build -t "${BASE}" "${HERE}/images/base"
  # Both workbenches from one Dockerfile; the second reuses every layer the
  # first built below its agent stage.
  for i in claude codex; do
    podman build --build-arg "BASE_IMAGE=${BASE}" --target "${i}" -t "$(wb_image "${i}")" "${HERE}/images/workbench"
  done
  for i in l2 l2-engine gh-broker egress-proxy mirror-gate; do
    podman build --build-arg "BASE_IMAGE=${BASE}" -t "localhost/airlock-${i}:${TAG}" "${HERE}/images/${i}"
  done
}

# The published images, tagged as the local ones, for anyone who would rather
# not build them. Prints what each tag resolved to: the published index
# digest, the one to pin by, rather than this platform's manifest.
cmd_pull() {
  local i ref
  for i in base workbench-claude workbench-codex l2 l2-engine gh-broker egress-proxy mirror-gate; do
    ref="$(pull_published "${i}")" || die "could not pull ${REGISTRY}/airlock-${i}"
    echo "workbench: ${i} ${ref}"
  done
}

# Pull one published image, tag it as the local one, and print the reference
# to pin it by: the published index digest, not this platform's manifest.
# errexit does not reach into a command substitution, so every step returns
# on failure itself, and callers check the status.
pull_published() {
  local ref mine index
  ref="${REGISTRY}/airlock-$1:${WORKBENCH_PULL_TAG:-latest}"
  podman pull --quiet "${ref}" >/dev/null || return 1
  podman tag "${ref}" "localhost/airlock-$1:${TAG}" || return 1
  mine="$(podman image inspect --format '{{.Digest}}' "${ref}")" || return 1
  [ -n "${mine}" ] || return 1
  index="$(podman image inspect --format '{{range .RepoDigests}}{{println .}}{{end}}' "${ref}" \
    | grep -F "${REGISTRY}/airlock-$1@" | grep -vF "${mine}" | head -n1 || true)"
  echo "${index:-${REGISTRY}/airlock-$1@${mine}}"
}

# Set a repository up for the workbench: the egress sets its files suggest,
# an L2 image on the published one pinned by digest, and the make targets.
# It writes only what is not there yet, and a Makefile gains the include
# once; it never edits anything else, so it is safe to run again.
cmd_init() {
  local top f sets=() l2 files
  top="$(git -C "${1:-${PWD}}" rev-parse --show-toplevel 2>/dev/null)" \
    || die "${1:-${PWD}} is not in a git repository"
  files="$(git -C "${top}" ls-files)"
  has() { grep -qE "$1" <<<"${files}"; }
  # The one step that can fail runs before anything is written, so a failed
  # init leaves the repository as it found it.
  if [ ! -e "${top}/.devcontainer/l2/Dockerfile" ]; then
    l2="$(pull_published l2)" || die "could not pull ${REGISTRY}/airlock-l2; nothing written"
  fi
  mkdir -p "${top}/.devcontainer/l2"

  f="${top}/.devcontainer/egress-sets"
  if [ -e "${f}" ]; then
    echo "workbench: kept ${f}"
  else
    # pre-commit builds its hook environments from PyPI and npm, so a
    # repository with hooks gets both whatever its own language.
    { has '(^|/)(pyproject\.toml|setup\.(py|cfg)|Pipfile|requirements[^/]*\.txt)$' || has '^\.pre-commit-config\.yaml$'; } && sets+=(python)
    { has '(^|/)package\.json$' || has '^\.pre-commit-config\.yaml$'; } && sets+=(node)
    has '(^|/)go\.mod$' && sets+=(golang)
    has '(^|/)(Dockerfile|Containerfile|[^/]*compose[^/]*\.ya?ml)$' && sets+=(docker-hub)
    has '\.tf$' && sets+=(hashicorp)
    {
      echo "# The network services this repository's hooks, tests and builds reach,"
      echo "# through its egress proxy (workbench, github and ghcr are always on). One"
      echo "# per line; \`podman run --rm localhost/airlock-egress-proxy:local"
      echo "# egress-refresh --list\` lists every set. Written by host/workbench init"
      echo "# from this repository's files: check it, and add what they missed."
      if [ "${#sets[@]}" -gt 0 ]; then printf '%s\n' "${sets[@]}"; fi
    } > "${f}"
    echo "workbench: wrote ${f} (${sets[*]:-no sets})"
    has '(^|/)(Cargo\.toml|Gemfile|composer\.json|pom\.xml|build\.gradle)$' \
      && echo "workbench: this repository uses a package registry no egress set covers yet; its installs will be refused until one exists (images/egress-proxy/sets/)"
  fi

  f="${top}/.devcontainer/l2/Dockerfile"
  if [ -e "${f}" ]; then
    echo "workbench: kept ${f}"
  else
    cat > "${f}" <<DOCKERFILE
# This repository's L2 image: where its hooks, tests and package installs
# run, with the working tree and nothing else (no network, no credentials).
# \`l2\` builds it inside the L2 engine the first time it is needed, and again
# whenever this file changes. See docs/LAYERS.md in devcontainer-airlock.
#
# It starts from the shared L2 image, pinned by digest, which already carries
# pre-commit, Python, Node, Go and the common linters. Add what this
# repository's hooks and tests need below: prefer a distribution package,
# then a vendor's own signed apt repository, then the tool's official
# container image.
ARG L2_IMAGE=${l2}
# hadolint ignore=DL3006
FROM \${L2_IMAGE}
DOCKERFILE
    echo "workbench: wrote ${f} (${l2})"
  fi

  f="${top}/Makefile"
  if [ -e "${f}" ] && grep -q 'host/workbench\.mk' "${f}"; then
    echo "workbench: kept ${f} (it already includes the workbench targets)"
  else
    # Recipe lines start with a tab, written by printf so this script holds none.
    if [ ! -e "${f}" ]; then
      printf '%s\n' '.PHONY: all help' '' 'all: help' '' 'help:' > "${f}"
      printf '\t%s\n' '@$(MAKE) --no-print-directory workbench-help' >> "${f}"
    fi
    cat >> "${f}" <<'MAKEFILE'

# The workbench targets (make claude, make codex, make unlock and the rest)
# from a devcontainer-airlock clone, by default the one next to this
# repository's main clone. Written by host/workbench init.
WORKBENCH_HOME ?= $(abspath $(dir $(shell git rev-parse --path-format=absolute --git-common-dir 2>/dev/null))../devcontainer-airlock)
-include $(WORKBENCH_HOME)/host/workbench.mk

MAKEFILE
    printf '%s\n' '' '.PHONY: workbench-help' \
      'ifeq ($(wildcard $(WORKBENCH_HOME)/host/workbench.mk),)' 'workbench-help:' >> "${f}"
    printf '\t%s\n' "@echo 'Workbench: clone ivan-pinatti-labs/devcontainer-airlock next to this repository, or set WORKBENCH_HOME.'" >> "${f}"
    printf '%s\n' 'endif' >> "${f}"
    echo "workbench: added the workbench targets to ${f}"
  fi

  echo "workbench: next: commit these, then make workbench-up (or make claude); in a workbench, l2-hooks-install once"
  echo "workbench: a repository whose main clone holds data other containers use also wants an empty .devcontainer/workbench-worktree-only"
}

# The egress proxy, one for the host, on the podman network for its own way
# out and on every registered workspace's internal network, at .2 there. It
# is started with the networks of the workspaces already registered, so a
# restart puts every workspace back.
start_proxy() {
  local f net nets=()
  running "${PROXY}" && return
  mkdir -p "${EGRESS_DIR}"
  # The proxy runs as its own account, not as you, so it reads the folder
  # (mounted on its own, past the private folder around it) as anyone.
  # It holds workspace paths, subnets and set names, nothing secret.
  chmod 700 "${RUN}/workbench"
  chmod 755 "${EGRESS_DIR}"
  for f in "${EGRESS_DIR}"/*.conf; do
    [ -f "${f}" ] || continue
    net="workbench-net-$(basename "${f}" .conf)"
    if podman network exists "${net}"; then
      nets+=(--network "${net}:ip=$(net_proxy_ip "${net}")")
    else
      rm -f "${f}"
    fi
  done
  podman rm -f "${PROXY}" >/dev/null 2>&1 || true
  podman volume exists egress-cache || podman volume create egress-cache >/dev/null
  podman run -d --name "${PROXY}" \
    --network podman "${nets[@]}" \
    --cap-drop=all --security-opt no-new-privileges --read-only \
    --tmpfs /run/egress:U --tmpfs /run/squid:U --tmpfs /tmp \
    -v egress-cache:/var/lib/egress:U \
    -v "${EGRESS_DIR}:/etc/egress/workspaces:ro,Z" \
    "${PROXY_IMAGE}" >/dev/null
  for _ in $(seq 1 100); do
    podman logs "${PROXY}" 2>&1 | grep -q 'Accepting HTTP' && return
    running "${PROXY}" || break
    sleep 0.3
  done
  podman logs "${PROXY}" 2>&1 | tail -5 >&2
  die "the egress proxy did not start; podman logs ${PROXY}"
}

# Give a workspace its way out: its internal network, its registration with
# the proxy (the subnet and the sets it selected), the proxy on that network,
# and a reload, which leaves every other workspace's tunnels open. Run on
# every `up`, so a changed .devcontainer/egress-sets takes effect then.
proxy_join() {
  local ws="$1" sets
  sets="$(egress_sets "${ws}")"
  # `mirror` in .devcontainer/egress-sets is not a set the proxy knows: it
  # says the workspace installs through the package mirror, and a workspace
  # that lists it and nothing else reaches no registry directly at all.
  case ",${sets}," in
    *,mirror,*)
      mirror_on || die "${ws} lists mirror in .devcontainer/egress-sets; the package mirror is off (WORKBENCH_MIRROR=${MIRROR})"
      sets="$(printf '%s\n' "${sets}" | tr ',' '\n' | grep -vx mirror | paste -sd, -)" ;;
  esac
  # Every name checked against the proxy image before anything changes, so
  # a bad one costs nothing: not an old proxy, not a registration, and never
  # a registration a restarted proxy would refuse to start with.
  check_sets "${ws}" "${sets}"
  ensure_net "${ws}"
  # A workspace started before the proxy was shared has a proxy of its own
  # holding .2 on its network. Its workbenches find the shared one at the
  # same address, so they keep working across the swap.
  podman rm -f -t 5 "egress-proxy-$(slug "${ws}")" >/dev/null 2>&1 || true
  proxy_register "$(slug "${ws}")" "${ws}" "${sets}"
}

# Register network workbench-net-$1 with the proxy for owner $2 (a workspace
# path, or the mirror) with sets $3, connect the proxy there and reload.
proxy_register() {
  local slug="$1" ws="$2" sets="$3" net f owner
  net="workbench-net-${slug}"
  f="${EGRESS_DIR}/${slug}.conf"
  mkdir -p "${EGRESS_DIR}"
  chmod 755 "${EGRESS_DIR}"
  owner="$(sed -n 's/^workspace=//p' "${f}" 2>/dev/null || true)"
  [ -z "${owner}" ] || [ "${owner}" = "${ws}" ] \
    || die "the egress proxy already serves ${owner} as ${slug}, another folder of the same name; stop it first (host/workbench down ${owner})"
  # The registration it replaces, if any, comes back when anything after
  # this fails, so a running workspace keeps its rules.
  rm -f "${f}.prev"
  if [ -f "${f}" ]; then cp -p "${f}" "${f}.prev"; fi
  printf 'workspace=%s\nsubnet=%s\nsets=%s\n' "${ws}" "$(net_subnet "${net}")" "${sets}" > "${f}.tmp"
  chmod 644 "${f}.tmp"
  mv "${f}.tmp" "${f}"
  # In a child shell, so a start_proxy that dies comes back here to be undone.
  if ! (start_proxy) || ! proxy_connect "${net}" "$(net_proxy_ip "${net}")" \
    || ! podman exec "${PROXY}" egress-reload >/dev/null; then
    if [ -f "${f}.prev" ]; then mv "${f}.prev" "${f}"; else rm -f "${f}"; fi
    if running "${PROXY}"; then
      podman exec "${PROXY}" egress-reload >/dev/null 2>&1 || true
      podman logs --tail 5 "${PROXY}" >&2
    fi
    die "the egress proxy could not take ${ws} (sets: ${sets}); its previous rules, if any, are back, and the other workspaces keep theirs"
  fi
  rm -f "${f}.prev"
}

# The proxy on network $1 at address $2, unless it is there already.
proxy_connect() {
  podman inspect --format '{{range $n, $_ := .NetworkSettings.Networks}}{{$n}} {{end}}' "${PROXY}" \
    | tr ' ' '\n' | grep -qx "$1" && return 0
  podman network connect --ip "$2" "$1" "${PROXY}"
}

# Die unless every name in $2 (comma separated) is an egress set the proxy
# image knows. For workspace $1, in the message.
check_sets() {
  local known name
  known="$(podman run --rm --network none "${PROXY_IMAGE}" egress-refresh --list | awk '{print $1}')" \
    || die "could not list the egress sets in ${PROXY_IMAGE}"
  for name in ${2//,/ }; do
    grep -qx "${name}" <<<"${known}" \
      || die "${1} asks for egress set '${name}', which the proxy does not know; known sets: $(paste -sd' ' <<<"${known}")"
  done
}

# Take a workspace off the proxy: its rules first, then the network.
proxy_leave() {
  local ws="$1"
  rm -f "${EGRESS_DIR}/$(slug "${ws}").conf"
  running "${PROXY}" || return 0
  podman exec "${PROXY}" egress-reload >/dev/null 2>&1 || true
  podman network disconnect -f "$(net_name "${ws}")" "${PROXY}" >/dev/null 2>&1 || true
}

# The package mirror (docs/LAYERS.md, "Package mirror"), one for the host
# like the egress proxy, and on unless WORKBENCH_MIRROR=0. Two
# containers on a network of their own: the backend (Nexus Repository CE),
# whose only way out is the egress proxy with the upstream registries' sets,
# and the gate, the only part clients reach, at .254 on every workspace's
# network. The backend is never on a workspace network.
MIRROR_SETS=python,node,golang,docker-hub,ghcr,ubuntu,alpine,fedora
mirror_on() {
  case "${MIRROR}" in
    1 | on | yes | true) return 0 ;;
    '' | 0 | off | no | false) return 1 ;;
    *) die "WORKBENCH_MIRROR is '${MIRROR}'; use 1 or 0" ;;
  esac
}
# The gate's address on workspace $1's network, and the mirror network's
# own addresses: the proxy at .2, the gate at .254, the backend at .10.
# The gate takes the top of the range: the engine and the workbenches get
# the next free addresses from the bottom (measured: .1, .3, .4), so a low
# fixed one would collide.
mirror_ip() { local s; s="$(net_subnet "$(net_name "$1")")"; echo "${s%.0/24}.254"; }
mirror_net_ip() { local s; s="$(net_subnet "${MIRROR_NET}")"; echo "${s%.0/24}.$1"; }

start_mirror() {
  local nexus upstream f net nets=() heap="${WORKBENCH_MIRROR_HEAP:-1024}" fresh=""
  create_net "${MIRROR_NET}"
  check_sets "the package mirror" "${MIRROR_SETS}"
  proxy_register airlock-mirror mirror "${MIRROR_SETS}"
  nexus="$(mirror_net_ip 10)"
  upstream="$(mirror_net_ip 2):8888"
  if ! running mirror-nexus; then
    podman image exists "${NEXUS_IMAGE}" || podman pull --quiet "${NEXUS_IMAGE}" >/dev/null
    podman volume exists mirror-nexus-data || podman volume create mirror-nexus-data >/dev/null
    podman rm -f mirror-nexus >/dev/null 2>&1 || true
    # No --network podman: the backend's only way out is the egress proxy,
    # where no Sonatype host is on any set, so its telemetry goes nowhere.
    podman run -d --name mirror-nexus --network "${MIRROR_NET}:ip=${nexus}" \
      --cap-drop=all --security-opt no-new-privileges \
      -v mirror-nexus-data:/nexus-data \
      -e INSTALL4J_ADD_VM_PARAMS="-Xms${heap}m -Xmx${heap}m -XX:MaxDirectMemorySize=${heap}m -Djava.util.prefs.userRoot=/nexus-data/javaprefs" \
      "${NEXUS_IMAGE}" >/dev/null
    fresh=1
  fi
  if [ -n "${fresh}" ] || ! running mirror-gate; then
    podman volume exists mirror-admin || podman volume create mirror-admin >/dev/null
    echo "workbench: provisioning the package mirror (the first start takes about a minute)" >&2
    podman run --rm --name mirror-provision --network "${MIRROR_NET}" --add-host "mirror-nexus:${nexus}" \
      --cap-drop=all --security-opt no-new-privileges \
      -v mirror-nexus-data:/nexus-data:ro -v mirror-admin:/var/lib/mirror-admin:U \
      -e NEXUS_URL=http://mirror-nexus:8081 -e UPSTREAM_PROXY="${upstream}" \
      "${GATE_IMAGE}" /usr/local/lib/mirror-gate/backends/nexus/provision \
      /usr/local/lib/mirror-gate/backends/nexus/repositories.json \
      || die "the package mirror could not be provisioned; podman logs mirror-nexus"
  fi
  running mirror-gate && return
  mkdir -p "${MIRROR_DIR}"
  chmod 700 "${MIRROR_DIR}"
  for f in "${MIRROR_DIR}"/*.ws; do
    [ -f "${f}" ] || continue
    net="workbench-net-$(basename "${f}" .ws)"
    if podman network exists "${net}"; then
      nets+=(--network "${net}:ip=$(net_gate_ip "${net}")")
    else
      rm -f "${f}"
    fi
  done
  podman volume exists mirror-osv || podman volume create mirror-osv >/dev/null
  podman rm -f mirror-gate >/dev/null 2>&1 || true
  podman run -d --name mirror-gate --network "${MIRROR_NET}:ip=$(mirror_net_ip 254)" "${nets[@]}" \
    --add-host "mirror-nexus:${nexus}" \
    --cap-drop=all --security-opt no-new-privileges --read-only --tmpfs /tmp \
    -v mirror-osv:/var/lib/mirror-gate/osv:U \
    -e HTTPS_PROXY="http://${upstream}" -e https_proxy="http://${upstream}" \
    -e MIN_AGE_DAYS="${WORKBENCH_MIRROR_MIN_AGE:-0}" \
    "${GATE_IMAGE}" >/dev/null
  for _ in $(seq 1 50); do
    podman logs mirror-gate 2>&1 | grep -q 'listening on 8081' && return
    running mirror-gate || break
    sleep 0.2
  done
  podman logs mirror-gate 2>&1 | tail -5 >&2
  die "the package mirror's gate did not start; podman logs mirror-gate"
}
net_gate_ip() { local s; s="$(net_subnet "$1")"; echo "${s%.0/24}.254"; }

# Put the gate on workspace $1's network, at .254, and write the registry
# mirror settings its engine mounts.
mirror_join() {
  local ws="$1" slug net
  slug="$(slug "${ws}")"
  net="$(net_name "${ws}")"
  mkdir -p "${MIRROR_DIR}"
  printf '%s\n' "${ws}" > "${MIRROR_DIR}/${slug}.ws"
  if ! podman inspect --format '{{range $n, $_ := .NetworkSettings.Networks}}{{$n}} {{end}}' mirror-gate \
    | tr ' ' '\n' | grep -qx "${net}"; then
    podman network connect --ip "$(mirror_ip "${ws}")" "${net}" mirror-gate
  fi
  mirror_registries "${ws}" >/dev/null
}

# The engine's registry mirror settings for workspace $1: docker.io and
# ghcr.io through the gate's registry ports. Prints the file's path.
mirror_registries() {
  local f gate
  f="${MIRROR_DIR}/$(slug "$1").registries.conf"
  gate="$(mirror_ip "$1")"
  mkdir -p "${MIRROR_DIR}"
  cat > "${f}" <<CONF
# Written by host/workbench: pulls go through the package mirror's gate.
[[registry]]
prefix = "docker.io"
location = "docker.io"
[[registry.mirror]]
location = "${gate}:5000"
insecure = true

[[registry]]
prefix = "ghcr.io"
location = "ghcr.io"
[[registry.mirror]]
location = "${gate}:5001"
insecure = true
CONF
  chmod 644 "${f}"
  echo "${f}"
}

mirror_leave() {
  local slug
  slug="$(slug "$1")"
  rm -f "${MIRROR_DIR}/${slug}.ws" "${MIRROR_DIR}/${slug}.registries.conf"
  running mirror-gate || return 0
  podman network disconnect -f "$(net_name "$1")" mirror-gate >/dev/null 2>&1 || true
}

start_broker() {
  running gh-broker && return
  podman secret exists "${GH_SECRET}" \
    || die "no podman secret ${GH_SECRET}; create it: podman secret create ${GH_SECRET} <file holding the token>"
  [ -n "${GH_OWNERS}" ] \
    || die "set WORKBENCH_GH_OWNERS in ${CONFIG} to the GitHub owners (users or organizations) the broker may act on, comma separated"
  mkdir -p "${GH_DIR}"
  chmod 700 "${RUN}/workbench" "${GH_DIR}"
  podman rm -f gh-broker >/dev/null 2>&1 || true
  # WORKBENCH_ROOT, read only and not relabelled: the broker can read only
  # what a workbench has already labelled for this category, which is enough
  # for gh to find the repository a command was run from.
  podman run -d --name gh-broker \
    --userns=keep-id:uid=1000,gid=1000 "${LABEL_OPTS[@]}" \
    --cap-drop=all --security-opt no-new-privileges --read-only --tmpfs /tmp \
    --secret "${GH_SECRET},type=env,target=GH_TOKEN" -e GH_BROKER_OWNERS="${GH_OWNERS}" \
    -v "${GH_DIR}:/run/gh-broker:Z" \
    -v "${ROOT}:${ROOT}:ro" \
    "${BROKER_IMAGE}" >/dev/null
}

start_ssh_agent() {
  running devcontainer-ssh-agent && return
  if [ ! -f "${SSH_KEY}" ]; then
    echo "workbench: no ${SSH_KEY}, so no ssh-agent; git push will not work (docs/LAYERS.md)" >&2
    return
  fi
  mkdir -p "${SSH_DIR}"
  chmod 700 "${SSH_DIR}"
  if [ ! -s "${SSH_DIR}/known_hosts" ]; then
    # GitHub's host keys from GitHub's own API, fetched in a container, so the
    # workbench can verify the host strictly.
    podman run --rm --network podman "${BASE}" \
      sh -c 'curl -fsS https://api.github.com/meta | jq -r ".ssh_keys[] | \"github.com \" + ."' \
      > "${SSH_DIR}/known_hosts"
  fi
  podman rm -f devcontainer-ssh-agent >/dev/null 2>&1 || true
  podman run -d --name devcontainer-ssh-agent \
    --network=none --cap-drop=all --read-only --security-opt no-new-privileges \
    --userns=keep-id "${LABEL_OPTS[@]}" \
    -v "${SSH_DIR}:/sock:Z" -v "${SSH_KEY}:/key/id:ro,Z" \
    --entrypoint ssh-agent "$(wb_image claude)" -D -a /sock/agent.sock >/dev/null
}

start_engine() {
  local ws="$1" name dir extra=() p gitdir=()
  name="$(engine_name "${ws}")"
  dir="$(engine_dir "${ws}")"
  check_owner "${name}" workbench.engine "${ws}"
  running "${name}" && return
  for p in $(profiles "${ws}"); do
    case "${p}" in
      nested-network)
        extra+=(--device /dev/net/tun --security-opt unmask=/proc/sys
          -e CONTAINERS_CONF_OVERRIDE=/usr/local/share/devcontainer/containers-bridge-network.conf) ;;
      nested-devices)
        extra+=(--device /dev/net/tun) ;;
    esac
  done
  mkdir -p "${dir}"
  chmod 700 "${dir}"
  set_proxy_env "${ws}" engine
  if mirror_on; then
    extra+=(-v "$(mirror_registries "${ws}"):/etc/containers/registries.conf.d/50-airlock-mirror.conf:ro,Z")
  fi
  mapfile -t gitdir < <(ws_mounts "${ws}")
  podman volume exists "${name}" || podman volume create "${name}" >/dev/null
  ensure_l2_store
  podman rm -f "${name}" >/dev/null 2>&1 || true
  podman run -d --name "${name}" \
    --label workbench.engine="${ws}" \
    --userns=keep-id:uid=1000,gid=1000 "${LABEL_OPTS[@]}" --device /dev/fuse \
    "${extra[@]}" \
    --network "$(net_name "${ws}")" "${PROXY_ENV[@]}" \
    "${gitdir[@]}" \
    -v "${dir}:/run/l2-engine:Z" \
    -v "${name}:/home/dev/.local/share/containers" \
    -v "${L2_STORE}:${L2_STORE_PATH}:ro" \
    "${ENGINE_IMAGE}" >/dev/null
  for _ in $(seq 1 50); do
    [ -S "${dir}/podman.sock" ] && return
    sleep 0.2
  done
  die "the L2 engine did not open its socket; podman logs ${name}"
}

# Whether WORKBENCH_VOICE asks for voice mode. Off unless set.
voice_on() {
  case "${WORKBENCH_VOICE:-}" in
    1 | on | yes | true) return 0 ;;
    '' | 0 | off | no | false) return 1 ;;
    *) die "WORKBENCH_VOICE is '${WORKBENCH_VOICE}'; use 1 or 0" ;;
  esac
}

# Every Claude workbench gets a folder of its own, read only, for the
# microphone pipe of a voice session. It stays empty unless one runs.
voice_opts() {
  local dir
  [ "$(agent_of "$2")" = claude ] || return 0
  dir="${VOICE_ROOT}/$1"
  mkdir -p "${dir}"
  chmod 700 "${VOICE_ROOT}" "${dir}"
  printf '%s\n' --label workbench.voice=ready -v "${dir}:/run/workbench-voice:ro,Z"
}

# The workbench of one agent. It mounts that agent's state folder and not the
# other's.
start_workbench() {
  local ws="$1" agent="$2" name gitdir=() history=() hist voice=()
  name="$(wb_name "${ws}" "${agent}")"
  check_owner "${name}" workbench.workspace "${ws}"
  running "${name}" && return
  mkdir -p "${DATA}/${agent}"
  set_proxy_env "${ws}"
  mapfile -t gitdir < <(ws_mounts "${ws}")
  # Captured in this shell, so a history setting that is wrong stops the
  # start instead of vanishing with a process substitution.
  hist="$(history_mounts "${ws}" "${agent}")" || exit 1
  if [ -n "${hist}" ]; then mapfile -t history <<<"${hist}"; fi
  hist="$(voice_opts "${name}" "${agent}")" || exit 1
  if [ -n "${hist}" ]; then mapfile -t voice <<<"${hist}"; fi
  podman rm -f "${name}" >/dev/null 2>&1 || true
  podman run -d --name "${name}" \
    --label workbench.workspace="${ws}" --label workbench.agent="${agent}" \
    --tz="${WORKBENCH_TZ:-local}" \
    --userns=keep-id:uid=1000,gid=1000 "${LABEL_OPTS[@]}" \
    --network "$(net_name "${ws}")" "${PROXY_ENV[@]}" \
    -e GIT_AUTHOR_NAME="$(git config --get user.name || true)" -e GIT_AUTHOR_EMAIL="$(git config --get user.email || true)" \
    -e GIT_COMMITTER_NAME="$(git config --get user.name || true)" -e GIT_COMMITTER_EMAIL="$(git config --get user.email || true)" \
    -e SSH_AUTH_SOCK=/run/devcontainer-ssh/agent.sock \
    -e GIT_SSH_COMMAND="ssh -o UserKnownHostsFile=/run/devcontainer-ssh/known_hosts -o StrictHostKeyChecking=yes -o HostKeyAlias=github.com -o Hostname=ssh.github.com -o Port=443 -o ProxyCommand='socat - PROXY:$(proxy_ip "${ws}"):%h:%p,proxyport=8888'" \
    "${gitdir[@]}" \
    -v "${DATA}/${agent}:/home/dev/.$(agent_of "${agent}"):Z" "${history[@]}" \
    -v "${GH_DIR}:/run/gh-broker" \
    -v "${SSH_DIR}:/run/devcontainer-ssh" \
    -v "$(engine_dir "${ws}"):/run/l2-engine" \
    "${voice[@]}" \
    -w "${ws}" \
    --entrypoint catatonit "$(wb_image "$(agent_of "${agent}")")" -- workbench-init >/dev/null
}

cmd_up() {
  local ws agent
  ws="$(workspace "${1:-}")"
  # Checked here, in this shell, before anything starts: later these are read
  # inside command substitutions, where a bad entry would only end that inner shell.
  profiles "${ws}" >/dev/null || exit 1
  egress_sets "${ws}" >/dev/null || exit 1
  case "${ws}/" in
    "${ROOT}"/*) ;;
    *) die "${ws} is not under WORKBENCH_ROOT (${ROOT}); the gh broker could not see it" ;;
  esac
  lock_state
  start_helpers
  proxy_join "${ws}"
  if mirror_on; then
    start_mirror
    mirror_join "${ws}"
  fi
  fill_l2_store
  start_engine "${ws}"
  sync_l2 "${ws}"
  for agent in ${AGENTS}; do
    start_workbench "${ws}" "${agent}"
    echo "workbench: ${agent}: host/workbench ${agent}, or attach VS Code to $(wb_name "${ws}" "${agent}")"
  done
  unlock_state
  echo "workbench: up for ${ws} (L2 engine $(engine_name "${ws}"))"
}

start_helpers() {
  mkdir -p "${SSH_DIR}" "${GH_DIR}"
  start_broker
  start_ssh_agent
  start_proxy
}

cmd_helpers() {
  start_helpers
  echo "workbench: helpers up (gh-broker, devcontainer-ssh-agent, ${PROXY})"
}

# Stopping the proxy cuts every workspace off the network until it is back;
# the registrations stay, so the next start puts them all back.
cmd_helpers_down() {
  podman rm -f -t 5 gh-broker devcontainer-ssh-agent "${PROXY}" >/dev/null 2>&1 || true
}

cmd_restart_proxy() {
  local f served=""
  podman rm -f -t 5 "${PROXY}" >/dev/null 2>&1 || true
  start_proxy
  for f in "${EGRESS_DIR}"/*.conf; do
    [ -f "${f}" ] && served="${served} $(basename "${f}" .conf)"
  done
  echo "workbench: egress proxy restarted, serving:${served:- nothing yet}"
}

cmd_restart_broker() {
  podman rm -f -t 5 gh-broker >/dev/null 2>&1 || true
  start_broker
  echo "workbench: gh broker restarted"
}

cmd_install_units() {
  local dir="${XDG_CONFIG_HOME:-${HOME}/.config}/systemd/user"
  mkdir -p "${dir}"
  cat > "${dir}/workbench-helpers.service" <<UNIT
# Written by ${HERE}/host/workbench install-units.
[Unit]
Description=Workbench helpers: egress proxy, gh broker, ssh-agent
After=default.target

[Service]
Type=oneshot
RemainAfterExit=yes
Environment=WORKBENCH_ROOT=${ROOT}
ExecStart=${HERE}/host/workbench helpers
ExecStop=${HERE}/host/workbench helpers-down

[Install]
WantedBy=default.target
UNIT
  systemctl --user daemon-reload
  systemctl --user enable workbench-helpers.service
  echo "workbench: installed ${dir}/workbench-helpers.service; it starts the helpers at your next login"
  echo "workbench: remove with: systemctl --user disable workbench-helpers.service && rm ${dir}/workbench-helpers.service"
}

cmd_unlock() {
  running devcontainer-ssh-agent || die "the ssh-agent is not running; host/workbench up first"
  # An agent started by an older host/workbench mounted the key's folder,
  # not the key itself. Holding nothing it could lose while locked, it is
  # started again the current way.
  if ! podman exec devcontainer-ssh-agent test -f /key/id; then
    podman rm -f -t 3 devcontainer-ssh-agent >/dev/null
    start_ssh_agent
  fi
  podman exec -it -e SSH_AUTH_SOCK=/sock/agent.sock devcontainer-ssh-agent \
    ssh-add -t 8h /key/id
}

# Run a command (default: a shell) in agent $1's workbench for workspace $2,
# in the folder you are in when it is inside the workspace.
cmd_shell() {
  local agent="${1:-}" ws name cwd
  if ! valid_agent "${agent:-none}"; then
    echo "workbench: which agent? host/workbench shell claude|codex[-<account>] [WORKSPACE] (accounts: ${ACCOUNTS:-none, see WORKBENCH_ACCOUNTS})" >&2
    exit 2
  fi
  ws="$(workspace "${2:-}")"
  shift 2 2>/dev/null || shift $#
  name="$(wb_name "${ws}" "${agent}")"
  # An agent asked for by name starts even when WORKBENCH_AGENTS leaves it
  # out of `up`.
  if ! running "${name}"; then
    cmd_up "${ws}" >/dev/null
    running "${name}" || start_workbench "${ws}" "${agent}"
  fi
  cwd="${PWD}"
  case "${cwd}/" in "${ws}"/*) ;; *) cwd="${ws}" ;; esac
  if [ "$(agent_of "${agent}")" = claude ] && voice_on; then
    voice_session "${name}" -w "${cwd}" "${name}" "${@:-bash}"
  fi
  # TERM and COLORTERM from your terminal (bare -e copies them, and skips one
  # that is unset): podman exec would set TERM=xterm and no COLORTERM, and
  # Claude Code would then draw in 16 colors instead of the terminal's own.
  exec podman exec -it -e TERM -e COLORTERM -w "${cwd}" "${name}" "${@:-bash}"
}

# A session with the host microphone, push to talk. PipeWire, on the host,
# gives the session a named pipe in this workbench's voice folder (16 kHz
# mono, what Claude Code records), and a second pipe the other way, on which
# the rec in the workbench writes one word: start when Claude Code begins a
# recording (while space is held), stop when it ends. Only in between is the
# microphone routed into the pipe (voice_listen). Nothing in the workbench
# can talk to the host's audio server. When voice cannot be set up, this
# says why and returns, and the session starts without it.
voice_session() {
  local name="$1" dir ctl sink reader
  shift
  dir="${VOICE_ROOT}/${name}"
  ctl="${dir}/ctl-$$"
  if [ "$(podman inspect --format '{{index .Config.Labels "workbench.voice"}}' "${name}")" != ready ]; then
    echo "workbench: voice: ${name} was started before voice existed, so this session has no microphone; host/workbench down (which ends every session in it) and start again for it" >&2
    return 0
  fi
  if ! command -v pactl >/dev/null; then
    echo "workbench: voice: no pactl on the host (PipeWire's or PulseAudio's tools), so this session has no microphone" >&2
    return 0
  fi
  if ! sink="$(pactl load-module module-pipe-sink sink_name="airlock_voice_$$" file="${dir}/mic-$$" \
    format=s16le rate=16000 channels=1)"; then
    echo "workbench: voice: PipeWire refused the microphone pipe, so this session has no microphone" >&2
    return 0
  fi
  if ! mkfifo -m 600 "${ctl}"; then
    pactl unload-module "${sink}" 2>/dev/null || true
    echo "workbench: voice: could not make the control pipe, so this session has no microphone" >&2
    return 0
  fi
  voice_listen "$$" "${ctl}" &
  reader=$!
  trap 'kill "${reader}" 2>/dev/null; wait "${reader}" 2>/dev/null; pactl unload-module "${sink}" 2>/dev/null; rm -f "${dir}/mic-$$" "${ctl}"' EXIT
  podman exec -it -e TERM -e COLORTERM -e WORKBENCH_VOICE_MIC="/run/workbench-voice/mic-$$" \
    -e WORKBENCH_VOICE_CTL="/run/workbench-voice/ctl-$$" "$@"
  exit $?
}

# The host end of a voice session's control pipe. It routes the microphone
# into the session's pipe on "start", and stops on "stop", after ten minutes
# of one recording, and when the session ends. What arrives is compared
# with those two words, never run, and read at most 16 bytes at a time.
voice_listen() {
  local id="$1" ctl="$2" loop="" word
  trap '[ -z "${loop}" ] || pactl unload-module "${loop}" 2>/dev/null; exit 0' TERM
  # Open for reading and writing, so the pipe never reports end of file
  # between one recording and the next.
  exec 3<>"${ctl}"
  while true; do
    word=""
    if [ -n "${loop}" ]; then
      read -r -n 16 -t 600 -u 3 word || word=stop
    else
      read -r -n 16 -u 3 word || continue
    fi
    case "${word}" in
      start)
        if [ -z "${loop}" ]; then
          loop="$(pactl load-module module-loopback source=@DEFAULT_SOURCE@ sink="airlock_voice_${id}" latency_msec=20)" || loop=""
        fi ;;
      stop)
        if [ -n "${loop}" ]; then
          pactl unload-module "${loop}" 2>/dev/null || true
          loop=""
        fi ;;
    esac
  done
}

# claude --remote-control, for the agent and account named (or the default
# claude), pairing with a device over Anthropic's relay, with voice when
# WORKBENCH_VOICE asks. DO_NOT_TRACK stays set: Claude Code 2.1.283 starts
# Remote Control with it (measured 2026-10-01), as its documentation says.
cmd_remote() {
  local agent="${1:-claude}" ws name cwd bin
  valid_agent "${agent}" || { echo "workbench: which agent? host/workbench remote claude[-<account>] [WORKSPACE]" >&2; exit 2; }
  bin="$(agent_of "${agent}")"
  [ "${bin}" = claude ] || die "${bin} has no remote control mode (Codex's own experimental 'codex remote-control' runs a daemon; use host/workbench shell ${agent} and run it by hand)"
  ws="$(workspace "${2:-}")"
  name="$(wb_name "${ws}" "${agent}")"
  if ! running "${name}"; then
    cmd_up "${ws}" >/dev/null
    running "${name}" || start_workbench "${ws}" "${agent}"
  fi
  cwd="${PWD}"
  case "${cwd}/" in "${ws}"/*) ;; *) cwd="${ws}" ;; esac
  if voice_on; then
    voice_session "${name}" -w "${cwd}" "${name}" claude --remote-control
  fi
  exec podman exec -it -e TERM -e COLORTERM -w "${cwd}" "${name}" claude --remote-control
}

cmd_load_l2() {
  local ws name
  ws="$(workspace "${1:-}")"
  name="$(engine_name "${ws}")"
  running "${name}" || die "no L2 engine running for ${ws}; host/workbench up first"
  fill_l2_store
  sync_l2 "${ws}"
}

# The L2 images every engine shares: one podman image store, on a volume this
# script fills from the host's images and every engine mounts read only (its
# storage.conf lists it as an additional image store). An engine then starts
# without a copy of its own, about a gigabyte and several seconds each.
# Images an engine builds or pulls go to its own store, where a tag wins over
# the same tag here.
L2_STORE=l2-store
L2_STORE_PATH=/var/lib/airlock/l2-store

# podman "$@" on the shared store, in a throwaway container of the engine
# image, under the same user mapping and label as the engines, so what it
# writes is what they read.
l2_store() {
  podman run --rm -i --network none \
    --userns=keep-id:uid=1000,gid=1000 "${LABEL_OPTS[@]}" --device /dev/fuse \
    -v "${L2_STORE}:/home/dev/.local/share/containers" \
    --entrypoint podman "${ENGINE_IMAGE}" "$@"
}

# The store's volume, laid out (lock files included) before any engine
# mounts it: an engine cannot create them on its read only mount.
ensure_l2_store() {
  podman volume exists "${L2_STORE}" && return
  podman volume create "${L2_STORE}" >/dev/null
  l2_store images >/dev/null
}

# Whether engine $1 mounts the shared store; one started by an older
# host/workbench does not, and gets its own copy, as before.
engine_shares_store() {
  podman inspect --format '{{range .Mounts}}{{.Name}} {{end}}' "$1" 2>/dev/null \
    | tr ' ' '\n' | grep -qx "${L2_STORE}"
}

# Put the host's L2 images in the shared store when they are missing there or
# older, so a rebuilt L2 image reaches every workspace on its next `up`
# without anyone remembering load-l2.
fill_l2_store() {
  local image mine theirs
  ensure_l2_store
  # An image replaced here stays while any engine runs: its containers may
  # be using its layers, and a prune run here cannot see them. With no
  # engine running, nothing uses them.
  if ! podman ps --format '{{.Names}}' | grep -q '^l2-engine-'; then
    l2_store image prune --force >/dev/null 2>&1 || true
  fi
  for image in "${L2_IMAGE}" ${L2_EXTRA_IMAGES:-}; do
    mine="$(podman image inspect --format '{{.Id}}' "${image}" 2>/dev/null)" || continue
    theirs="$(l2_store image inspect --format '{{.Id}}' "${image}" 2>/dev/null || true)"
    if [ "${mine}" != "${theirs}" ]; then
      echo "workbench: copying ${image} into the shared L2 store"
      podman save "${image}" | l2_store load --quiet >/dev/null
    fi
  done
}

# Workspace $1's engine and the L2 images: an engine that shares the store
# drops any copy of its own that would hide the shared image behind the same
# tag (from before it shared one); an older engine gets its own copy.
sync_l2() {
  local name image mine theirs id
  name="$(engine_name "$1")"
  for image in "${L2_IMAGE}" ${L2_EXTRA_IMAGES:-}; do
    mine="$(podman image inspect --format '{{.Id}}' "${image}" 2>/dev/null)" || continue
    if engine_shares_store "${name}"; then
      id="$(podman exec "${name}" podman images --format '{{.ReadOnly}} {{.ID}} {{.Repository}}:{{.Tag}}' \
        | awk -v want="${image}" '$1 == "false" && $3 == want {print $2}')"
      if [ -n "${id}" ]; then
        podman exec "${name}" podman untag "${id}" "${image}" >/dev/null
      fi
      continue
    fi
    theirs="$(podman exec "${name}" podman image inspect --format '{{.Id}}' "${image}" 2>/dev/null || true)"
    if [ "${mine}" != "${theirs}" ]; then
      echo "workbench: copying ${image} into the L2 engine"
      podman save "${image}" | podman exec -i "${name}" podman load --quiet >/dev/null
    fi
  done
}

cmd_status() {
  podman ps -a --filter name='^(egress-proxy.*|mirror-.*|gh-broker|devcontainer-ssh-agent|workbench-.*|l2-engine-.*)$' \
    --format 'table {{.Names}}\t{{.Status}}\t{{.Image}}'
}

cmd_down() {
  local ws names
  ws="$(workspace "${1:-}")"
  lock_state
  # Every workbench of the workspace, whatever agent or account, and
  # workbench-<name>, the single workbench from before the split.
  podman ps -a --filter label=workbench.workspace="${ws}" --format '{{.Names}}' \
    | xargs -r podman rm -f -t 5 >/dev/null 2>&1 || true
  # egress-proxy-<name>: the workspace's own proxy, from before it was shared.
  podman rm -f -t 5 "workbench-$(slug "${ws}")" "$(engine_name "${ws}")" "egress-proxy-$(slug "${ws}")" \
    >/dev/null 2>&1 || true
  mirror_leave "${ws}"
  proxy_leave "${ws}"
  podman network rm "$(net_name "${ws}")" >/dev/null 2>&1 || true
  echo "workbench: down"
  # A failed listing is not an empty one: stop nothing on a guess.
  if ! names="$(podman ps -a --format '{{.Names}}')"; then
    echo "workbench: could not list the containers left, so the shared services keep running" >&2
    return 1
  fi
  if ! grep -qE '^(workbench|l2-engine)-' <<<"${names}"; then
    stop_shared
    echo "workbench: no workspace left, so the shared services stopped too; the next up starts them"
  fi
}

# Every shared service: the package mirror, the egress proxy, the gh broker
# and the ssh-agent. Their volumes (the proxy's cache, the mirror's cache,
# admin password and malicious package lists) stay, so the next start is warm.
stop_shared() {
  podman rm -f -t 5 mirror-gate mirror-nexus "${PROXY}" gh-broker devcontainer-ssh-agent >/dev/null 2>&1 || true
  rm -f "${EGRESS_DIR}/airlock-mirror.conf"
  podman network rm "${MIRROR_NET}" >/dev/null 2>&1 || true
}

case "${1:-}" in
  build) cmd_build ;;
  pull) cmd_pull ;;
  init) cmd_init "${2:-}" ;;
  up) cmd_up "${2:-}" ;;
  unlock) cmd_unlock ;;
  shell) shift; cmd_shell "$@" ;;
  remote) cmd_remote "${2:-}" "${3:-}" ;;
  claude | codex | claude-* | codex-*) cmd_shell "$1" "${2:-}" "$(agent_of "$1")" ;;
  accounts) echo "${ACCOUNTS}" ;;
  load-l2) cmd_load_l2 "${2:-}" ;;
  status) cmd_status ;;
  down) cmd_down "${2:-}" ;;
  helpers) cmd_helpers ;;
  helpers-down) cmd_helpers_down ;;
  restart-broker) cmd_restart_broker ;;
  restart-proxy) cmd_restart_proxy ;;
  install-units) cmd_install_units ;;
  -h | --help | help) sed -n '3,/^    2  usage error$/p' "$0" ;;
  *) sed -n '3,/run it yourself)$/p' "$0" >&2; exit 2 ;;
esac
