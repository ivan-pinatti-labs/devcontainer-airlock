#!/usr/bin/env python3
"""Find the secrets agents wrote into their transcripts, and redact them.

host/scrub runs this in a container with no network (docs/SCRUB.md). It
gets copies of the files to look at, never the files themselves, and says
which copies to put back:

- /work/manifest: one copy a line, N, size, mtime, kind (host or
  workbench), home and path of the original, tab separated; the copy is
  /work/files/N.
- /work/context: what is live, `busy HOME`, `busy-all HOME`, `live ID`,
  `closed ID`, `open PATH`, `now EPOCH`, `quiet SECONDS`.
- /work/known/: a file per secret whose value the host holds, named for it.
- /work/known-env/: files of KEY=value lines, each value a secret.
- /work/gitleaks.toml.
- /work/out/: what it writes back, redacted/N (the redacted copies) and
  actions (`replace N` and `done N SIZE` lines).
- /state: the ledger of the secrets found, and the key its HMACs are made
  with.

Tier 1 is the secrets the host holds, searched for as they are. Tiers 2 and
3 are gitleaks, run over a view of each file in which every JSON string is
decoded, so a rule sees `api_key: "..."` rather than its escaped form. A
hit from a rule in REPORT_ONLY is reported, never redacted or kept.
"""

# cspell:words argparse isdigit ljust CREAT fdopen findall fromhex fullmatch hashlib hexdigest hmac HMACs iterdir removeprefix setdefault strftime subparsers surrogateescape TRUNC WRONLY
from __future__ import annotations

import argparse
import hashlib
import hmac
import json
import os
import re
import secrets
import subprocess
import sys
import time
from pathlib import Path
from typing import NamedTuple

# Where host/scrub mounts what the scan works on; fixed, never taken from
# the command line.
WORK = Path("/work")
STATE = Path("/state")
GITLEAKS = "/gitleaks/usr/bin/gitleaks"
# Long random looking strings with no known format: reported until their
# hits on real history are measured (make scrub-check), never redacted.
REPORT_ONLY = {"generic-high-entropy"}
# Shorter hits are noise; a secret this long or longer keeps its last four
# characters in its placeholder, so a rotation can be checked against it.
MIN_LENGTH = 8
TAIL_FROM = 20
TAIL_SAFE = re.compile(r"[A-Za-z0-9+/=_.-]{4}")
# A Claude Code conversation id, which names a conversation's own files.
CONVERSATION = re.compile(r"[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}")
RED = "\033[1;31m"
RESET = "\033[0m"
ENCODING = {"encoding": "utf-8", "errors": "surrogateescape"}


class ScrubError(Exception):
    """A scan that cannot go on; nothing is put back."""


class Entry(NamedTuple):
    n: str
    size: int
    mtime: int
    kind: str
    home: str
    path: str


class Context:
    """What is live: homes in use, conversations running and ended, files
    held open, and how recently a host file may have been written."""

    def __init__(self, now: int = 0, quiet: int = 600, **sets: set[str]):
        self.now = now
        self.quiet = quiet
        self.busy = sets.get("busy", set())
        self.busy_all = sets.get("busy_all", set())
        self.live = sets.get("live", set())
        self.closed = sets.get("closed", set())
        self.open = sets.get("open", set())


class Output:
    def __init__(self, color: bool):
        self.color = color

    def line(self, text: str, alarm: bool = False) -> str:
        if alarm and self.color:
            text = f"{RED}{text}{RESET}"
        return f"scrub: {text}"

    def say(self, text: str, alarm: bool = False) -> None:
        print(self.line(text, alarm), flush=True)


def read_manifest(path: Path) -> list[Entry]:
    entries = []
    if not path.exists():
        return entries
    for line in path.read_text(**ENCODING).splitlines():
        if not line:
            continue
        n, size, mtime, kind, home, original = line.split("\t", 5)
        entries.append(Entry(n, int(size), int(mtime), kind, home, original))
    return entries


def read_context(path: Path) -> Context:
    ctx = Context(now=int(time.time()))
    if not path.exists():
        return ctx
    for line in path.read_text(**ENCODING).splitlines():
        key, _, value = line.partition(" ")
        match key:
            case "busy":
                ctx.busy.add(value)
            case "busy-all":
                ctx.busy_all.add(value)
            case "live":
                ctx.live.add(value)
            case "closed":
                ctx.closed.add(value)
            case "open":
                ctx.open.add(value)
            case "now":
                ctx.now = int(value)
            case "quiet":
                ctx.quiet = int(value)
            case _:
                raise ScrubError(f"unknown context line: {key}")
    return ctx


def is_live(entry: Entry, ctx: Context) -> bool:
    """Whether a session may still write the file, so it is only read.

    A file some process holds open is live, and so is everything in a home a
    session of unknown conversations uses. In a home a session uses, a file
    that names no conversation (history.jsonl, paste-cache) is live, and one
    that names a conversation is live while that conversation is. A file in
    a host home written in the last `quiet` seconds counts as live too,
    unless it names a conversation known to have ended."""
    if entry.path in ctx.open or entry.home in ctx.busy_all:
        return True
    relative = entry.path.removeprefix(entry.home)
    ids = set(CONVERSATION.findall(relative))
    if ids & ctx.live:
        return True
    if entry.home in ctx.busy and not ids:
        return True
    recent = ctx.now - entry.mtime < ctx.quiet
    return entry.kind == "host" and recent and not ids & ctx.closed


def env_values(text: str) -> dict[str, str]:
    """The values of KEY=value lines, as a .env file holds them."""
    values = {}
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.removeprefix("export ").split("=", 1)
        value = value.strip()
        if len(value) >= 2 and value[0] == value[-1] and value[0] in "'\"":
            value = value[1:-1]
        values[key.strip()] = value
    return values


def read_known(work: Path) -> dict[str, str]:
    """Tier 1: name to value, for the secrets the host holds."""
    known = {}
    folder = work / "known"
    if folder.is_dir():
        for path in sorted(folder.iterdir()):
            known[path.name] = path.read_text(**ENCODING).strip()
    folder = work / "known-env"
    if folder.is_dir():
        for path in sorted(folder.iterdir()):
            for key, value in env_values(path.read_text(**ENCODING)).items():
                known[f"env:{key}"] = value
    return {name: value for name, value in known.items() if len(value) >= MIN_LENGTH}


def is_json_lines(path: str) -> bool:
    return path.endswith(".jsonl")


def is_json(path: str) -> bool:
    return path.endswith(".json")


def strings(value, key: str | None = None):
    """Every string in a decoded JSON value, a string under a key as
    `key: value`, so a rule that wants the name beside the value sees both."""
    if isinstance(value, dict):
        for k, v in value.items():
            yield from strings(v, k)
    elif isinstance(value, list):
        for v in value:
            yield from strings(v)
    elif isinstance(value, str):
        yield f"{key}: {value}" if key else value


def parses(text: str) -> bool:
    try:
        json.loads(text)
    except ValueError:
        return False
    return True


def view(path: str, text: str) -> str:
    """What gitleaks scans for a file: its JSON strings decoded, one a line
    (a line that is not JSON as it is); any other file as it is."""
    if is_json(path) and parses(text):
        return "\n".join(strings(json.loads(text)))
    if not (is_json(path) or is_json_lines(path)):
        return text
    out = []
    for line in text.splitlines():
        if parses(line):
            out.extend(strings(json.loads(line)))
        else:
            out.append(line)
    return "\n".join(out)


def gitleaks(work: Path, binary: str) -> list[dict]:
    report = work / "out" / "gitleaks.json"
    result = subprocess.run(
        [
            binary,
            "dir",
            str(work / "view"),
            "--config",
            str(work / "gitleaks.toml"),
            "--max-decode-depth",
            "0",
            "--no-banner",
            "--no-color",
            "--log-level",
            "error",
            "--exit-code",
            "0",
            "--report-format",
            "json",
            "--report-path",
            str(report),
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    if result.returncode != 0:
        raise ScrubError(f"gitleaks failed: {result.stderr.strip()}")
    findings = json.loads(report.read_text())
    report.unlink()
    return findings or []


def forms(value: str) -> list[str]:
    """The ways a value is written in a file: as it is, and as a JSON string
    holds it. Longest first, so no form is replaced inside another."""
    found = {value, json.dumps(value)[1:-1], json.dumps(value, ensure_ascii=False)[1:-1]}
    return sorted(found, key=len, reverse=True)


def tail(value: str) -> str:
    end = value[-4:]
    if len(value) >= TAIL_FROM and TAIL_SAFE.fullmatch(end):
        return end
    return ""


def placeholder(rule: str, value: str) -> str:
    end = tail(value)
    return f"[REDACTED:{rule}:...{end}]" if end else f"[REDACTED:{rule}]"


def plural(count: int, noun: str) -> str:
    return f"{count} {noun}" + ("" if count == 1 else "s")


def shown(rule: str, value: str) -> str:
    end = tail(value)
    return f"{rule} ...{end}" if end else rule


def where(paths: list[str]) -> str:
    return f"in {paths[0]}" if len(paths) == 1 else f"in {len(paths)} files"


class Found:
    """A distinct secret this scan found, and the files it is redacted in,
    waits for a session in, or cannot be redacted in."""

    def __init__(self, rule: str, value: str, entry: dict | None):
        what = shown(rule, value)
        self.label = f"secret #{entry['id']} ({what})" if entry else what
        self.number = entry["id"] if entry else 0
        self.redacted: list[str] = []
        self.waiting: list[str] = []
        self.kept: list[str] = []

    def report(self, check: bool, every: bool = True) -> str:
        """Its one line, or nothing when all it has is what a scan redacts and
        leaves host/scrub to say, or (`every` false: a session start or
        end) waiting, which the scan counts in one line instead."""
        parts = []
        if check and self.redacted:
            parts.append(f"would be redacted {where(self.redacted)}")
        if self.waiting and every:
            verb = "would wait" if check else "waits"
            parts.append(f"{verb} for a session to end {where(self.waiting)}")
        if self.kept and every:
            parts.append(f"cannot be redacted {where(self.kept)}")
        return f"{self.label}: {'; '.join(parts)}. Rotate it" if parts else ""


def still_valid(path: str, before: str, after: str) -> bool:
    """A redacted JSON file still parses, and in JSON lines every line that
    parsed before still does."""
    if is_json(path) and parses(before):
        return parses(after)
    if is_json_lines(path):
        old, new = before.split("\n"), after.split("\n")
        if len(old) != len(new):
            return False
        return all(parses(b) for a, b in zip(old, new, strict=True) if parses(a))
    return True


class Ledger:
    """One entry per distinct secret, by the HMAC of its value under a key
    that stays on the host, kept until the secret is rotated."""

    def __init__(self, state: Path, writable: bool):
        self.path = state / "ledger.json"
        self.writable = writable
        self.data = {"next": 1, "entries": []}
        if self.path.exists():
            self.data = json.loads(self.path.read_text())
        self.key = self.load_key(state / "key")

    def load_key(self, path: Path) -> bytes:
        if path.exists():
            return bytes.fromhex(path.read_text().strip())
        key = secrets.token_bytes(32)
        if self.writable:
            fd = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
            with os.fdopen(fd, "w") as f:
                f.write(key.hex())
        return key

    def digest(self, value: str) -> str:
        return hmac.new(self.key, value.encode(**ENCODING), hashlib.sha256).hexdigest()

    def entry(self, value: str) -> dict | None:
        mac = self.digest(value)
        return next((e for e in self.data["entries"] if e["hmac"] == mac), None)

    def by_id(self, number: int) -> dict | None:
        return next((e for e in self.data["entries"] if e["id"] == number), None)

    def seen(self, value: str, rule: str, path: str, known: str | None, out: Output) -> dict:
        today = time.strftime("%Y-%m-%d")
        entry = self.entry(value)
        if entry is None:
            entry = {
                "id": self.data["next"],
                "hmac": self.digest(value),
                "rule": rule,
                "tail": tail(value),
                "known": known,
                "first_seen": today,
                "files": [],
                "status": "open",
            }
            self.data["next"] += 1
            self.data["entries"].append(entry)
        elif entry["status"] == "rotated" and path not in entry["files"]:
            # Found again somewhere new, not a copy already counted that
            # waits for its session to end.
            entry["status"] = "open"
            entry.pop("rotated", None)
            out.say(f"secret #{entry['id']} ({shown(rule, value)}) was marked rotated, and is found again", alarm=True)
        entry["known"] = entry["known"] or known
        entry["last_seen"] = today
        if path not in entry["files"]:
            entry["files"].append(path)
        return entry

    def rotate_changed(self, known: dict[str, str], out: Output) -> None:
        """Tier 1 secrets whose value the host no longer holds are rotated."""
        current = {name: self.digest(value) for name, value in known.items()}
        for entry in self.data["entries"]:
            name = entry["known"]
            if entry["status"] == "open" and name in current and current[name] != entry["hmac"]:
                self.mark_rotated(entry)
                out.say(f"secret #{entry['id']} ({name}) has a new value now, so it is marked rotated")

    def mark_rotated(self, entry: dict) -> None:
        entry["status"] = "rotated"
        entry["rotated"] = time.strftime("%Y-%m-%d")

    def report_open(self, out: Output, listed: set[str], every: bool) -> None:
        """The secrets not rotated yet: each one not already said this run
        (`listed`, by HMAC) on a manual run, only their count otherwise, so
        a session start stays short."""
        still = [e for e in self.data["entries"] if e["status"] == "open"]
        if not still:
            return
        if not every:
            out.say(f"{plural(len(still), 'secret')} not rotated yet; make scrub-check lists them", alarm=True)
            return
        for e in still:
            if e["hmac"] in listed:
                continue
            what = f"{e['rule']} ...{e['tail']}" if e["tail"] else e["rule"]
            then = f"; it is marked rotated on its own once {e['known']} changes" if e["known"] else ""
            out.say(
                f"secret #{e['id']} ({what}): found before, first on {e['first_seen']}, in {plural(len(e['files']), 'file')}, "
                f"and not rotated yet. Rotate it{then}",
                alarm=True,
            )
        out.say('once rotated: make scrub-rotated ID=<n> (several: ID="3 5 8"; every one: ID=all)')

    def save(self) -> None:
        if not self.writable:
            return
        tmp = self.path.with_suffix(".tmp")
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
        with os.fdopen(fd, "w") as f:
            json.dump(self.data, f, indent=1)
        os.replace(tmp, self.path)


def hits_of(entries: list[Entry], texts: dict[str, str], known: dict[str, str], findings: list[dict]):
    """For each copy, its secrets: value to (rule, known name or None), the
    tier 1 ones first; and the report only hits apart."""
    redact: dict[str, dict[str, tuple[str, str | None]]] = {e.n: {} for e in entries}
    report: dict[str, set[str]] = {e.n: set() for e in entries}
    for e in entries:
        for name, value in known.items():
            if any(f in texts[e.n] for f in forms(value)):
                redact[e.n][value] = (name, name)
    for finding in findings:
        n = Path(finding["File"]).name
        value = finding["Secret"]
        if n not in redact or len(value) < MIN_LENGTH:
            continue
        if finding["RuleID"] in REPORT_ONLY:
            report[n].add(value)
        else:
            redact[n].setdefault(value, (finding["RuleID"], None))
    for n, values in report.items():
        values -= {v for v in values if any(v in r or r in v for r in redact[n])}
    return redact, report


def redacted(text: str, found: dict[str, tuple[str, str | None]]) -> tuple[str, list[str]]:
    """The text with every secret replaced, and the secrets not in it as
    they were found (so not redacted)."""
    missing = []
    for value in sorted(found, key=len, reverse=True):
        rule = found[value][0]
        hit = False
        for form in forms(value):
            if form in text:
                text = text.replace(form, placeholder(rule, value))
                hit = True
        if not hit:
            missing.append(value)
    return text, missing


def scan(args, out: Output) -> int:
    work, state = WORK, STATE
    entries = read_manifest(work / "manifest")
    ctx = read_context(work / "context")
    known = read_known(work)
    ledger = Ledger(state, writable=not args.check)
    texts = {e.n: (work / "files" / e.n).read_text(**ENCODING) for e in entries}
    findings = []
    if entries:
        (work / "view").mkdir(exist_ok=True)
        for e in entries:
            (work / "view" / e.n).write_text(view(e.path, texts[e.n]), **ENCODING)
        findings = gitleaks(work, GITLEAKS)
    redact, report = hits_of(entries, texts, known, findings)
    actions = []
    # One line per distinct secret, not per file it is in. A check says what
    # a scan would do: the same decisions, nothing written. What a scan
    # redacted is said by host/scrub once each file is replaced (its `hit`
    # actions), since it can still refuse a file that changed.
    secrets_found: dict[str, Found] = {}
    counts = {"redacted": 0, "waiting": 0, "kept": 0}
    (work / "out" / "redacted").mkdir(parents=True, exist_ok=True)
    for e in entries:
        found = redact[e.n]
        # Report only hits are many on real history: one line in all,
        # unless asked for each (--entropy).
        if args.entropy:
            for value in sorted(report[e.n]):
                out.say(f"{shown('generic-high-entropy', value)} in {e.path}: a random looking string, reported only (docs/SCRUB.md)")
        for value, (rule, name) in sorted(found.items()):
            entry = ledger.entry(value) if args.check else ledger.seen(value, rule, e.path, name, out)
            secrets_found.setdefault(value, Found(rule, value, entry))
        if is_live(e, ctx) and found:
            for value in found:
                secrets_found[value].waiting.append(e.path)
            counts["waiting"] += 1
            continue
        if not found:
            actions.append(f"done {e.n} {e.size}")
            continue
        text, missing = redacted(texts[e.n], found)
        for value in missing:
            secrets_found[value].kept.append(e.path)
        if text == texts[e.n]:
            counts["kept"] += 1
            actions.append(f"done {e.n} {e.size}")
            continue
        if not still_valid(e.path, texts[e.n], text):
            out.say(f"{e.path}: redacting it would break its JSON, so it is left as it is", alarm=True)
            for value in found.keys() - set(missing):
                secrets_found[value].kept.append(e.path)
            counts["kept"] += 1
            continue
        counts["kept"] += bool(missing)
        counts["redacted"] += 1
        for value in sorted(found):
            if value not in missing:
                secrets_found[value].redacted.append(e.path)
                if not args.check:
                    actions.append(f"hit {e.n} {secrets_found[value].label}")
        if args.check:
            continue
        copy = work / "out" / "redacted" / e.n
        copy.write_text(text, **ENCODING)
        actions.append(f"replace {e.n}")
        actions.append(f"done {e.n} {copy.stat().st_size}")
    for s in sorted(secrets_found.values(), key=lambda s: (s.number, s.label)):
        line = s.report(args.check, every=args.manual)
        if line:
            out.say(line, alarm=True)
    waiting = sum(1 for s in secrets_found.values() if s.waiting)
    kept = sum(1 for s in secrets_found.values() if s.kept)
    if waiting and not args.manual:
        out.say(f"{plural(waiting, 'secret')} in files a running session holds, redacted once it ends; make scrub-check lists them", alarm=True)
    if kept and not args.manual:
        out.say(f"{plural(kept, 'secret')} that cannot be redacted; make scrub-check lists them", alarm=True)
    if not args.check:
        ledger.rotate_changed(known, out)
        (work / "out" / "actions").write_text("".join(f"{a}\n" for a in actions))
    ledger.report_open(out, listed={ledger.digest(v) for v in secrets_found}, every=args.manual)
    loud = {n: len(values) for n, values in report.items() if values}
    if args.manual and loud and not args.entropy:
        out.say(
            f"{plural(sum(loud.values()), 'random looking string')} in {plural(len(loud), 'file')}, "
            "reported only, not redacted (docs/SCRUB.md); ENTROPY=1 (or --entropy) lists them"
        )
    if args.manual:
        verb = "would be redacted" if args.check else "to redact"
        out.say(
            f"{plural(len(entries), 'file')} looked at, {plural(len(secrets_found), 'secret')} in them: "
            f"{counts['redacted']} {verb}, {counts['waiting']} wait for a session to end, "
            f"{counts['kept']} keep something that cannot be redacted"
            + ("; dry run, nothing was changed" if args.check else "")
        )
    ledger.save()
    return 0


def listing(args, out: Output) -> int:
    """The ledger as a table: the secrets not rotated yet, or (--all) every
    one, with (--files) the files each was found in."""
    ledger = Ledger(STATE, writable=False)
    entries = sorted(ledger.data["entries"], key=lambda e: e["id"])
    rows = [e for e in entries if args.all or e["status"] == "open"]
    still = sum(1 for e in entries if e["status"] == "open")
    if not rows:
        out.say("no secret in the ledger yet" if not entries else "no secret is open; make scrub-list ALL=1 shows the rotated ones")
        return 0
    table = [("ID", "TYPE", "ENDS IN", "FIRST SEEN", "LAST SEEN", "FILES", "STATUS")]
    for e in rows:
        status = f"rotated {e['rotated']}" if e["status"] == "rotated" else "open"
        last = e.get("last_seen", e["first_seen"])
        table.append((str(e["id"]), e["rule"], e["tail"] or "-", e["first_seen"], last, str(len(e["files"])), status))
    widths = [max(len(row[i]) for row in table) for i in range(len(table[0]))]
    for i, row in enumerate(table):
        print("  ".join(cell.ljust(width) for cell, width in zip(row, widths, strict=True)).rstrip())
        if args.files and i:
            for path in rows[i - 1]["files"]:
                print(f"      {path}")
    out.say(f"{plural(still, 'secret')} open, {plural(len(entries) - still, 'secret')} rotated; once rotated: make scrub-rotated ID=<n>")
    return 0


def rotated(args, out: Output) -> int:
    """Mark secrets rotated: by id, several at once, or every open one."""
    ledger = Ledger(STATE, writable=True)
    if "all" in args.ids:
        chosen = [e for e in ledger.data["entries"] if e["status"] == "open"]
    else:
        chosen = []
        for raw in args.ids:
            entry = ledger.by_id(int(raw)) if raw.isdigit() else None
            if entry is None:
                out.say(f"no secret #{raw} in the ledger, so nothing was marked")
                return 2
            chosen.append(entry)
    for entry in chosen:
        ledger.mark_rotated(entry)
        out.say(f"secret #{entry['id']} ({entry['rule']}) marked rotated")
    if not chosen:
        out.say("no secret is open, so nothing was marked")
    ledger.save()
    return 0


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(prog="scrub-scan")
    parser.add_argument("--color", action="store_true")
    sub = parser.add_subparsers(dest="command", required=True)
    s = sub.add_parser("scan")
    s.add_argument("--check", action="store_true")
    s.add_argument("--manual", action="store_true")
    s.add_argument("--entropy", action="store_true")
    r = sub.add_parser("rotated")
    r.add_argument("ids", nargs="+")
    ls = sub.add_parser("list")
    ls.add_argument("--all", action="store_true")
    ls.add_argument("--files", action="store_true")
    args = parser.parse_args(argv)
    out = Output(color=args.color)
    try:
        if args.command == "scan":
            return scan(args, out)
        if args.command == "list":
            return listing(args, out)
        return rotated(args, out)
    except (ScrubError, OSError, ValueError) as error:
        out.say(f"the scan failed, nothing was changed: {error}", alarm=True)
        return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
