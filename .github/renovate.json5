{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Renovate is this template's active dependency bot: it covers every pin
  // surface this repository has. That is the pre-commit-checklists rev: pin
  // in .pre-commit-config.yaml, every commit-SHA action pin under
  // .github/workflows/, and the base image tag and digest on
  // images/base/Dockerfile's FROM line. It used to also cover asdf tool
  // versions in .tool-versions; asdf was removed from this organization on
  // 2026-09-19 and that file no longer exists, so the asdf manager is gone
  // with it. Tools now come from signed apt repositories and are
  // deliberately not version pinned at all; docs/TOOL_SOURCES.md says why,
  // and the weekly rebuild is what keeps them current. Dependabot's
  // own config for those same two ecosystems (dependabot.yml) is still
  // present, deliberately, but disabled (open-pull-requests-limit: 0 on
  // both its blocks): this repository is a GitHub template, so a project
  // created from it may prefer Dependabot for either ecosystem, and
  // dependabot.yml stays fully configured so that is a one-line change
  // there rather than reconstructing config from scratch. See README.md's
  // "What you get" and "Using this template" step 5. There is no
  // .env.example here, unlike ivan-pinatti-labs/rsync-crypt's copy of this
  // file, but there are two annotated version strings (the coding agent CLI
  // pins in images/base/Dockerfile), so enabledManagers below does name a
  // regex manager, as that repo's does.
  //
  // The test suite's hash locked tests/requirements.txt is the fifth
  // surface, moved by pip-compile, and the images `make coverage` runs are
  // annotated in the Makefile for custom.regex.
  //
  // enabledManagers below is an explicit list of exactly those five
  // managers, not left as a generic catch-all the way this template's
  // config was before this file was first aligned with the org's merge
  // pipeline (docs/MERGE_PIPELINE.md): this repo has nothing else for
  // Renovate to manage yet. A repo created from this template that grows
  // real dependencies beyond these surfaces (a Terraform module
  // registry, ...) needs to widen enabledManagers, or drop
  // it entirely to fall back to config:recommended's own defaults, once it
  // has something else for Renovate to watch; see README.md's "Using this
  // template" step 5.
  // customManagers:dockerfileVersions reads the `# renovate:` annotations
  // above the two ARG lines in images/workbench/Dockerfile that pin the coding
  // agent CLI versions. Neither the dockerfile manager (which only sees FROM
  // lines) nor any npm manager (there is no package.json here; the install
  // happens inside a RUN) extracts an annotated ARG, so without this preset
  // those two pins would sit unwatched while the config looked like it
  // covered the file. It was briefly removed alongside asdf, whose
  // ASDF_VERSION was its previous reason to exist, and came back with these
  // two.
  extends: ["config:recommended", "customManagers:dockerfileVersions"],

  // Kept on despite the standing, never-resolving tracking issue it opens.
  // Without it, "Renovate found nothing to update" and "Renovate silently
  // stopped seeing your dependencies" look identical, and the dashboard is
  // the only place Renovate reports detection errors and rate-limited
  // updates.
  dependencyDashboard: true,

  timezone: "America/Toronto",

  // Daily, not Saturday. A weekly schedule stacks on top of
  // minimumReleaseAge's 7 day floor below rather than overlapping it: a
  // release that misses its weekly slot by a day waits a full extra week, so
  // the oldest a package could sit before merging was up to 14 days even
  // though 7 was the intended floor. The floor itself never moved:
  // minimumReleaseAge is seven days either way, and what a weekly window
  // stretched was the worst case, not the minimum. Checking daily keeps the
  // schedule's own period short enough that it cannot add more than a day on
  // top of that floor.
  //
  // A pin-only bump resolves `Review Verified` through
  // the shared review verdict's bot lane without CodeRabbit ever being
  // asked, so a daily schedule consumes no extra review quota; see
  // ivan-pinatti-labs/.github's README.md under "Dependency policy".
  schedule: ["before 7am"],

  labels: ["dependencies"],
  commitMessagePrefix: "chore:",

  // Keep PR volume manageable so CI is not overwhelmed.
  prConcurrentLimit: 5,
  prHourlyLimit: 2,

  // The default deny. Overridden per update type by the first packageRules
  // entry below, which is the only place that grants it: an update type
  // this config has not thought about arrives unlabelled and waits for a
  // person rather than merging on the strength of a default nobody chose.
  automerge: false,

  // Rebase a bot pull request as soon as main moves past it, not only when
  // it conflicts. `Pin Only` reads a hash lock, and where a workflow's block
  // scalars sit, from main itself, and refuses when main has changed that
  // file since the pull request branched, because it can no longer prove
  // the diff's base. Without this such a pull request stays refused until a
  // person ticks its rebase box (pre-commit-checklists #118 sat refused for
  // two days). Renovate doing the rebase also keeps the push attributed to
  // renovate[bot], so a bot approval still counts as approval of the last
  // push. docker-torrent-box-with-vpn already carries this setting.
  rebaseWhen: "behind-base-branch",

  // The four pin surfaces this repository actually has. github-actions
  // covers every uses: SHA pin under .github/workflows/; pre-commit covers
  // .pre-commit-config.yaml's rev:; dockerfile covers the base image tag and
  // digest on images/base/Dockerfile's FROM line, and every other FROM line
  // pinned to an upstream image (the linters l2 copies out, and
  // quay.io/podman/stable under images/podman-nested); custom.regex covers the
  // two annotated ARG lines pinning the coding agent CLI versions in that
  // same file, and the VS Code extension pins in
  // images/workbench/vscode/extensions.txt. The first three are also
  // configured, disabled, in dependabot.yml; see the file header above.
  // Dropping a manager from this list is the other half of switching that
  // ecosystem back to Dependabot, alongside raising its
  // open-pull-requests-limit there.
  //
  // The dockerfile manager updates the tag and the digest of the FROM line
  // together. The apt packages a repository installs on top of this image
  // carry no version pin for Renovate to move; the two npm agent CLIs do,
  // and custom.regex is what moves them.
  // The images scripts/build-images.sh runs (a throwaway registry, trivy,
  // skopeo), host/workbench's mirror backend and host/scrub's gitleaks are
  // pinned by tag and digest in shell assignments, each under a
  // `# renovate:` annotation the dockerfileVersions preset does not look at,
  // since it only reads Dockerfiles. Pin Only grades them with its
  // shell_image_pin grammar (.github/pin-only.yml): the variable, the image
  // and the quoting have to stay as they are, and only the tag and the
  // digest may move, so a patch or minor bump merges unattended like any
  // other pin. A bump of the registry, trivy or skopeo still goes through
  // the job that builds and scans the images with them before it merges.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: [
        "/^scripts/build-images\\.sh$/",
        "/^host/scrub$/",
        "/^host/workbench$/",
      ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+=[^:\\s]+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})",
      ],
    },
    {
      // The container images `make coverage` runs, annotated the same way
      // but written as make variables:
      //   # renovate: datasource=docker depName=<image>
      //   NAME ?= <image>:<tag>@sha256:<digest>
      customType: "regex",
      managerFilePatterns: ["/^Makefile$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\s+[A-Z_]+ \\?= \\S+?:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})",
      ],
    },
    {
      // A git repository the workbench image builds from, pinned by release
      // tag and that tag's commit in one build argument, so the tag and the
      // commit move together (the build refuses a tag that is not the
      // commit):
      //   # renovate: datasource=github-tags depName=<owner>/<repository>
      //   ARG NAME_REF=<tag>@<commit>
      // Named _REF, not _VERSION, so customManagers:dockerfileVersions does
      // not also read it and move the tag alone. github-tags rather than
      // git-tags: git-tags carries no dates, so minimumReleaseAge (with
      // internalChecksFilter strict) would never let a bump open; github-tags
      // dates a tag by its commit, and carries the commit for the digest.
      customType: "regex",
      managerFilePatterns: ["/^images/workbench/Dockerfile$/"],
      matchStrings: [
        "# renovate: datasource=(?<datasource>github-tags) depName=(?<depName>\\S+)\\nARG [A-Z_]+_REF=(?<currentValue>[^@\\s]+)@(?<currentDigest>[0-9a-f]{40})",
      ],
    },
    {
      // The VS Code extensions baked into the workbench, one
      // `publisher.name@1.2.3` per line. Renovate has no Marketplace
      // datasource, so the vscode-extension custom datasource below reads the
      // index the Extension Index workflow publishes every day.
      customType: "regex",
      managerFilePatterns: ["/^images/workbench/vscode/extensions\\.txt$/"],
      matchStrings: [
        "(?:^|\\n)(?<depName>[A-Za-z0-9][A-Za-z0-9-]*\\.[A-Za-z0-9][A-Za-z0-9-]*)@(?<currentValue>\\d+\\.\\d+\\.\\d+)",
      ],
      datasourceTemplate: "custom.vscode-extension",
      versioningTemplate: "semver",
    },
  ],

  // The release lists for those extensions, one JSON file per extension in
  // the shape custom datasources take, each release dated by the Marketplace.
  // The Marketplace's own release query is a POST, which a custom datasource
  // cannot send, so .github/workflows/extension-index.yml asks it once a day
  // (scripts/extension-index.py) and commits the answers to the
  // `extension-index` branch, which holds nothing else and is never merged.
  // The releases are stable only, and only those built for linux-x64 or for
  // every platform; minimumReleaseAge below ages them like any other pin.
  // A repository created from this template points this at its own branch.
  customDatasources: {
    "vscode-extension": {
      defaultRegistryUrlTemplate: "https://raw.githubusercontent.com/ivan-pinatti-labs/devcontainer-airlock/extension-index/{{packageName}}.json",
      format: "json",
    },
  },

  // tests/requirements.txt is a hash lock compiled from
  // tests/requirements.in with `uv pip compile --generate-hashes`.
  // pip-compile reads the lock's header, bumps the pin in the .in file and
  // replays that command, so the hashes move with the version.
  // `--exclude-newer=P7D` in the header is a rolling window, so a replay
  // never resolves a release younger than seven days, transitive ones
  // included, matching minimumReleaseAge.
  "pip-compile": {
    managerFilePatterns: ["/(^|/)requirements\\.txt$/"],
  },

  // config:recommended extends :ignoreModulesAndTests, whose ignorePaths
  // include "**/tests/**", which would hide tests/requirements.txt from
  // pip-compile. ignorePaths is not mergeable, so this replaces the
  // inherited list; the two entries kept are Renovate's own bare default.
  ignorePaths: ["**/node_modules/**", "**/bower_components/**"],

  enabledManagers: [
    "github-actions",
    "pre-commit",
    "dockerfile",
    "custom.regex",
    "pip-compile",
  ],

  // Renovate's pre-commit manager ships disabled by its own default even
  // when named in enabledManagers above (confirmed with
  // `renovate --platform=local --dry-run=extract`, which listed the manager
  // as enabled but extracted zero dependencies from
  // .pre-commit-config.yaml until this block was added). github-actions
  // needs no equivalent block: it ships enabled by default.
  "pre-commit": {
    enabled: true,
  },

  // A cooling window before an update is offered at all, mirroring
  // ivan-pinatti-labs/rsync-crypt's reasoning: `Pin Only` proves a diff
  // changed nothing but a version token, and ivan-pinatti-labs/gh-actions documents
  // exactly what that covers,
  // but it cannot tell a good release from a backdoored one, because a
  // fresh supply chain attack has no advisory yet for any scanner to match.
  // Age is the only defence against that, and granting automerge above
  // without it would mean merging a release published minutes earlier,
  // unattended, with no person ever looking.
  //
  // Seven days, the same as the sibling repositories, because the reasoning
  // is about how long a compromised release typically takes to be spotted
  // and pulled, not about this repository's (much smaller) dependency
  // surface.
  minimumReleaseAge: "7 days",

  // Hold the pull request until the window is satisfied rather than opening
  // one that is not allowed to merge yet. Without this, minimumReleaseAge
  // still gates the merge, but Renovate opens the pull request immediately
  // regardless, so it would sit for up to seven days looking blocked for no
  // visible reason instead of not existing yet.
  internalChecksFilter: "strict",

  // The exception: a fix for a known vulnerability is not made safer by
  // aging, and null clears the inherited window for these updates only.
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
  },

  packageRules: [
    // What may merge without anyone looking, and the label that says so.
    //
    // First in the list on purpose: later rules win on any key they share
    // with an earlier one, and the group rule below sets a name and labels,
    // not automerge policy, so it cannot accidentally override this by
    // coming after it.
    //
    // The label is the whole point. bot-auto-merge.yml approves a Renovate
    // pull request only when it carries `automerge`, reading the label
    // rather than restating which update types are eligible, so the policy
    // lives here, once. `Pin Only` is the actual security gate behind that
    // trust: every changed line still has to be nothing but a version in a
    // pin position, checked line by line, before the label alone can do
    // anything; see docs/MERGE_PIPELINE.md.
    //
    // patch and minor only, across every enabled manager: a pinned action
    // or a pre-commit hook rev could each in principle offer a major, which
    // is exactly the case that needs a person to check nothing else in this
    // repository's tooling assumes the old major's behavior.
    {
      matchUpdateTypes: ["patch", "minor"],
      automerge: true,
      addLabels: ["automerge"],
    },
    // One grouped pull request per ecosystem, the same shape Dependabot's
    // own (disabled) groups in dependabot.yml produce, each with a
    // matching label added on top of the plain "dependencies" label above.
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
      groupSlug: "github-actions",
      labels: ["dependencies", "github-actions"],
    },
    {
      matchManagers: ["pre-commit"],
      groupName: "pre-commit hooks",
      groupSlug: "pre-commit-hooks",
      labels: ["dependencies", "pre-commit"],
    },
    {
      matchManagers: ["dockerfile"],
      groupName: "base image",
      groupSlug: "base-image",
      labels: ["dependencies", "docker"],
    },

    // Which Ubuntu release line the base image sits on is a decision, not a
    // version bump, and the patch-and-minor automerge rule above would
    // otherwise take it unattended: Renovate grades 26.04 to 26.10 a minor
    // update, and 26.10 is a nine month release rather than an LTS. The same
    // rule holds a new podman minor for podman-nested (v5.8 to v5.9) for a
    // person, since a test stack's behavior can change with it. That image
    // sits on an immutable tag, which upstream never rebuilds, so it gets no
    // digest updates; its security fixes come from the dnf upgrade in its
    // Dockerfile on the scheduled rebuild.
    {
      matchManagers: ["dockerfile"],
      matchUpdateTypes: ["minor", "major"],
      automerge: false,
    },

    // digest is its own update type in Renovate, matched by neither the
    // patch-and-minor rule above nor the minor-and-major one, so without
    // this it would fall through to the repository-wide `automerge: false`
    // default and wait for a person every week. It is the one base image
    // update that should merge on its own: the same tag, rebuilt upstream
    // with security fixes, which is precisely what the scheduled rebuild
    // exists to pick up, and it still has to pass Pin Only and the build
    // and scan job first.
    {
      matchManagers: ["dockerfile"],
      matchUpdateTypes: ["digest"],
      automerge: true,
      addLabels: ["automerge"],
    },

    // The two coding agent CLI versions, the only version pinned software in
    // this image. Everything installed with apt is deliberately unpinned
    // (docs/TOOL_SOURCES.md); these are pinned precisely so this cooldown and
    // `Pin Only` apply to them, because npm has no distribution maintainer
    // standing between a publisher and this build the way Ubuntu does. They
    // take the ordinary patch and minor automerge from the first rule above,
    // which the seven day window and the line by line pin check are what make
    // safe.
    {
      matchManagers: ["custom.regex"],
      matchDatasources: ["npm"],
      groupName: "coding agent CLIs",
      groupSlug: "agent-clis",
      labels: ["dependencies", "tooling"],
    },

    // The VS Code extensions run with the editor's full permissions, in the
    // workbench where the agents' logins are (docs/LAYERS.md, "Extensions").
    // They take the same lane as the agent CLIs: the seven day window, the
    // patch and minor automerge from the first rule above, and `Pin Only`'s
    // vscode_extension_pin grammar, which keeps each line's extension and
    // lets only its version move. A major waits for a person, and adding or
    // removing an extension is not a bump at all. Not grouped, so a major
    // held for review never holds back another extension's patch.
    {
      matchDatasources: ["custom.vscode-extension"],
      labels: ["dependencies", "vscode-extension"],
    },

    // The github-actions manager extracts more than uses: pins by default:
    // pull-request.yml's python-version: "3.14" passed to
    // actions/setup-python's with: (depType uses-with) is a shape
    // rsync-crypt's own PR #82 proved live there, proposing 3.13 to 3.14
    // with no way to ever merge it. Dependabot's github-actions ecosystem
    // never watched this shape either, it bumped uses: pins only, and
    // the shared pin-only check's rev_pin and action_sha grammars do
    // not match a with: input, so Pin Only would refuse a diff like this
    // and route it to a person every single time upstream Python cuts a
    // release, forever, since the shape never changes. Disabled here so
    // this template, and every repository created from it, stops
    // generating a pull request that can never pass its own required
    // check. matchDepTypes also covers github-runner (a literal runs-on:
    // value) for the same reason, even though nothing here happens to use
    // one today; pre-commit-checklists, pre-commit-checklists-demo and
    // rsync-crypt all carry the identical rule for the identical reason.
    {
      matchManagers: ["github-actions"],
      matchDepTypes: ["github-runner", "uses-with"],
      enabled: false,
    },

    // pip-compile bumps the exact pins in tests/requirements.in and
    // regenerates the hash locked tests/requirements.txt. One pull request
    // per dependency, labeled python.
    {
      matchManagers: ["pip-compile"],
      addLabels: ["python"],
    },

    // The images `make coverage` runs in the Makefile move by digest only. A
    // tag change is not a pin bump: python 3.14 is the interpreter the images
    // ship, node 24 the one the workbench ships, and kcov publishes nothing
    // but `latest`.
    {
      matchManagers: ["custom.regex"],
      matchFileNames: ["Makefile"],
      matchUpdateTypes: ["major", "minor", "patch"],
      enabled: false,
    },
    // What those images do move by, their digest, merges unattended. digest
    // is an update type of its own: the patch and minor grant above does not
    // match it, and any other digest grant here is scoped to another file.
    // Without this rule every one of these bumps arrived with no `automerge`
    // label, bot-auto-merge.yml gave it no approval, and it sat open with
    // every required check green. `Pin Only` grades the Makefile with its
    // `digest` grammar (.github/pin-only.yml), so the bot lane still has to
    // pass first.
    //
    // The seven day window still holds. These tags are rebuilt upstream every
    // week or two, and Renovate dates a digest by when its tag last moved, so
    // `renovate/stability-days` reads pending whenever a newer build is under
    // seven days old. With internalChecksFilter strict that newer build is
    // held back and the branch keeps the last one that did age: the status
    // describes the next candidate, not the branch, and no branch protection
    // requires it.
    {
      matchManagers: ["custom.regex"],
      matchFileNames: ["Makefile"],
      matchUpdateTypes: ["digest"],
      automerge: true,
      addLabels: ["automerge"],
    },
    // kcov's current builds are published only as `latest`: its newest
    // versioned image on Docker Hub is v42, from 2023, and current versioned
    // images are requested in kcov's own issue 481. A `latest` digest has no
    // release timestamp, and under timestamp-required with
    // internalChecksFilter strict Renovate never offers it: the pin never
    // moved. timestamp-optional lets it move, which means a new kcov build is
    // not aged by anything. Scoped to the `latest` tag, so a versioned kcov
    // pin keeps the seven day window. It runs only in `make coverage`, over
    // the test suite, and a build that breaks coverage fails that check
    // before the bump can merge.
    {
      matchManagers: ["custom.regex"],
      matchFileNames: ["Makefile"],
      matchPackageNames: ["docker.io/kcov/kcov"],
      matchCurrentValue: "latest",
      minimumReleaseAgeBehaviour: "timestamp-optional",
    },
    // Renovate's weekly refresh of the hash locked tests/requirements.txt
    // ("Refresh pip-compile outputs") merges unattended as well. It is its
    // own update type, lockFileMaintenance, which no grant above matches.
    // The lock's own `--exclude-newer=P7D` keeps every release it resolves
    // at least seven days old, and `Pin Only` grades it with
    // hash_locked_requirements: the same packages, none added or removed,
    // and every new hash one PyPI publishes for that release.
    {
      matchUpdateTypes: ["lockFileMaintenance"],
      automerge: true,
      addLabels: ["automerge"],
    },

    // agent-policy decides what the agents in the workbench may run. A
    // release of it can loosen as well as tighten, so it is reviewed where
    // that is decided, in its own repository: a CodeRabbit review and the
    // merge queue there, then a release cut from that merge. A patch or minor
    // release then takes the same lane here as any other pin, through the
    // automerge grant above and `Pin Only`'s arg_tag_commit grammar, which
    // holds the tag and its commit together. A major still waits for a
    // person. This rule only labels it, so a bump is easy to find.
    {
      matchDepNames: ["ivan-pinatti-labs/agent-policy"],
      addLabels: ["agent-policy"],
    },
    // The organization's own releases (ivan-pinatti-labs/gh-actions,
    // pre-commit-checklists, agent-policy and the rest) skip the seven day
    // window. It exists to give a compromised or broken third party release
    // time to be noticed before it lands here. These are cut by a workflow
    // from a reviewed merge to main, and each of them ages its own third
    // party inputs through the same window before anything reaches a
    // release, so the window has already been applied once, upstream, and a
    // second wait here only holds back fixes. The organization's own images
    // are already treated this way, for the same reason.
    // Whether a bump merges unattended is unchanged: that is still the
    // automerge rules above. ivan-pinatti-labs/.github's README.md,
    // "Dependency policy".
    {
      matchPackageNames: ["ivan-pinatti-labs/**"],
      minimumReleaseAge: null,
    },
  ],
}
