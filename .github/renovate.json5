{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",

  // Renovate is this template's active dependency bot: it covers every pin
  // surface this repository has. That is the pre-commit-checklists rev: pin
  // in .pre-commit-config.yaml, every commit-SHA action pin under
  // .github/workflows/, and the base image tag and digest on
  // images/base/Dockerfile's FROM line. It used to also cover asdf tool
  // versions in .tool-versions; asdf was removed from this organization on
  // 2026-09-19 and that file no longer exists, so the asdf manager is gone
  // with it. Tools now come from signed apt repositories and are
  // deliberately not version pinned at all; docs/TOOL_SOURCES.md says why,
  // and the weekly rebuild is what keeps them current. Dependabot's
  // own config for those same two ecosystems (dependabot.yml) is still
  // present, deliberately, but disabled (open-pull-requests-limit: 0 on
  // both its blocks): this repository is a GitHub template, so a project
  // created from it may prefer Dependabot for either ecosystem, and
  // dependabot.yml stays fully configured so that is a one-line change
  // there rather than reconstructing config from scratch. See README.md's
  // "What you get" and "Using this template" step 5. There is no
  // .env.example here, unlike ivan-pinatti-labs/rsync-crypt's copy of this
  // file, but there are two annotated version strings (the coding agent CLI
  // pins in images/base/Dockerfile), so enabledManagers below does name a
  // regex manager, as that repo's does.
  //
  // enabledManagers below is an explicit list of exactly those four
  // managers, not left as a generic catch-all the way this template's
  // config was before this file was first aligned with the org's merge
  // pipeline (docs/MERGE_PIPELINE.md): this repo has nothing else for
  // Renovate to manage yet. A repo created from this template that grows
  // real dependencies beyond these four surfaces (pip, a Terraform module
  // registry, ...) needs to widen enabledManagers, or drop
  // it entirely to fall back to config:recommended's own defaults, once it
  // has something else for Renovate to watch; see README.md's "Using this
  // template" step 5.
  // customManagers:dockerfileVersions reads the `# renovate:` annotations
  // above the two ARG lines in images/workbench/Dockerfile that pin the coding
  // agent CLI versions. Neither the dockerfile manager (which only sees FROM
  // lines) nor any npm manager (there is no package.json here; the install
  // happens inside a RUN) extracts an annotated ARG, so without this preset
  // those two pins would sit unwatched while the config looked like it
  // covered the file. It was briefly removed alongside asdf, whose
  // ASDF_VERSION was its previous reason to exist, and came back with these
  // two.
  extends: ["config:recommended", "customManagers:dockerfileVersions"],

  // Kept on despite the standing, never-resolving tracking issue it opens.
  // Without it, "Renovate found nothing to update" and "Renovate silently
  // stopped seeing your dependencies" look identical, and the dashboard is
  // the only place Renovate reports detection errors and rate-limited
  // updates.
  dependencyDashboard: true,

  timezone: "America/Toronto",

  // Daily, not Saturday. A weekly schedule stacks on top of
  // minimumReleaseAge's 7 day floor below rather than overlapping it: a
  // release that misses its weekly slot by a day waits a full extra week, so
  // the oldest a package could sit before merging was up to 14 days even
  // though 7 was the intended floor. The floor itself never moved:
  // minimumReleaseAge is seven days either way, and what a weekly window
  // stretched was the worst case, not the minimum. Checking daily keeps the
  // schedule's own period short enough that it cannot add more than a day on
  // top of that floor.
  //
  // A pin-only bump resolves `Review Verified` through
  // the shared review verdict's bot lane without CodeRabbit ever being
  // asked, so a daily schedule consumes no extra review quota; see
  // ivan-pinatti-labs/.github's README.md under "Dependency policy".
  schedule: ["before 7am"],

  labels: ["dependencies"],
  commitMessagePrefix: "chore:",

  // Keep PR volume manageable so CI is not overwhelmed.
  prConcurrentLimit: 5,
  prHourlyLimit: 2,

  // The default deny. Overridden per update type by the first packageRules
  // entry below, which is the only place that grants it: an update type
  // this config has not thought about arrives unlabelled and waits for a
  // person rather than merging on the strength of a default nobody chose.
  automerge: false,

  // The four pin surfaces this repository actually has. github-actions
  // covers every uses: SHA pin under .github/workflows/; pre-commit covers
  // .pre-commit-config.yaml's rev:; dockerfile covers the base image tag and
  // digest on images/base/Dockerfile's FROM line; custom.regex covers the
  // two annotated ARG lines pinning the coding agent CLI versions in that
  // same file. The first three are also
  // configured, disabled, in dependabot.yml; see the file header above.
  // Dropping a manager from this list is the other half of switching that
  // ecosystem back to Dependabot, alongside raising its
  // open-pull-requests-limit there.
  //
  // The dockerfile manager updates the tag and the digest of the FROM line
  // together. The apt packages a repository installs on top of this image
  // carry no version pin for Renovate to move; the two npm agent CLIs do,
  // and custom.regex is what moves them.
  // The images scripts/build-images.sh runs (a throwaway registry, trivy,
  // skopeo) are pinned by tag and digest in shell assignments, each under a
  // `# renovate:` annotation the dockerfileVersions preset does not look at,
  // since it only reads Dockerfiles. Pin Only has no grammar for a shell
  // assignment either (.github/pin-only.yml), so these bumps wait for a
  // person, which is the point: they change what scans the images.
  customManagers: [
    {
      customType: "regex",
      managerFilePatterns: [
        "/^scripts/build-images\\.sh$/",
        "/^host/workbench$/",
      ],
      matchStrings: [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+=[^:\\s]+:(?<currentValue>[^@\\s]+)@(?<currentDigest>sha256:[0-9a-f]{64})",
      ],
    },
  ],

  enabledManagers: [
    "github-actions",
    "pre-commit",
    "dockerfile",
    "custom.regex",
  ],

  // Renovate's pre-commit manager ships disabled by its own default even
  // when named in enabledManagers above (confirmed with
  // `renovate --platform=local --dry-run=extract`, which listed the manager
  // as enabled but extracted zero dependencies from
  // .pre-commit-config.yaml until this block was added). github-actions
  // needs no equivalent block: it ships enabled by default.
  "pre-commit": {
    enabled: true,
  },

  // A cooling window before an update is offered at all, mirroring
  // ivan-pinatti-labs/rsync-crypt's reasoning: `Pin Only` proves a diff
  // changed nothing but a version token, and ivan-pinatti-labs/gh-actions documents
  // exactly what that covers,
  // but it cannot tell a good release from a backdoored one, because a
  // fresh supply chain attack has no advisory yet for any scanner to match.
  // Age is the only defence against that, and granting automerge above
  // without it would mean merging a release published minutes earlier,
  // unattended, with no person ever looking.
  //
  // Seven days, the same as the sibling repositories, because the reasoning
  // is about how long a compromised release typically takes to be spotted
  // and pulled, not about this repository's (much smaller) dependency
  // surface.
  minimumReleaseAge: "7 days",

  // Hold the pull request until the window is satisfied rather than opening
  // one that is not allowed to merge yet. Without this, minimumReleaseAge
  // still gates the merge, but Renovate opens the pull request immediately
  // regardless, so it would sit for up to seven days looking blocked for no
  // visible reason instead of not existing yet.
  internalChecksFilter: "strict",

  // The exception: a fix for a known vulnerability is not made safer by
  // aging, and null clears the inherited window for these updates only.
  vulnerabilityAlerts: {
    minimumReleaseAge: null,
  },

  packageRules: [
    // What may merge without anyone looking, and the label that says so.
    //
    // First in the list on purpose: later rules win on any key they share
    // with an earlier one, and the group rule below sets a name and labels,
    // not automerge policy, so it cannot accidentally override this by
    // coming after it.
    //
    // The label is the whole point. bot-auto-merge.yml approves a Renovate
    // pull request only when it carries `automerge`, reading the label
    // rather than restating which update types are eligible, so the policy
    // lives here, once. `Pin Only` is the actual security gate behind that
    // trust: every changed line still has to be nothing but a version in a
    // pin position, checked line by line, before the label alone can do
    // anything; see docs/MERGE_PIPELINE.md.
    //
    // patch and minor only, across every enabled manager: a pinned action
    // or a pre-commit hook rev could each in principle offer a major, which
    // is exactly the case that needs a person to check nothing else in this
    // repository's tooling assumes the old major's behavior.
    {
      matchUpdateTypes: ["patch", "minor"],
      automerge: true,
      addLabels: ["automerge"],
    },
    // One grouped pull request per ecosystem, the same shape Dependabot's
    // own (disabled) groups in dependabot.yml produce, each with a
    // matching label added on top of the plain "dependencies" label above.
    {
      matchManagers: ["github-actions"],
      groupName: "github actions",
      groupSlug: "github-actions",
      labels: ["dependencies", "github-actions"],
    },
    {
      matchManagers: ["pre-commit"],
      groupName: "pre-commit hooks",
      groupSlug: "pre-commit-hooks",
      labels: ["dependencies", "pre-commit"],
    },
    {
      matchManagers: ["dockerfile"],
      groupName: "base image",
      groupSlug: "base-image",
      labels: ["dependencies", "docker"],
    },

    // Which Ubuntu release line the base image sits on is a decision, not a
    // version bump, and the patch-and-minor automerge rule above would
    // otherwise take it unattended: Renovate grades 26.04 to 26.10 a minor
    // update, and 26.10 is a nine month release rather than an LTS.
    {
      matchManagers: ["dockerfile"],
      matchUpdateTypes: ["minor", "major"],
      automerge: false,
    },

    // digest is its own update type in Renovate, matched by neither the
    // patch-and-minor rule above nor the minor-and-major one, so without
    // this it would fall through to the repository-wide `automerge: false`
    // default and wait for a person every week. It is the one base image
    // update that should merge on its own: the same tag, rebuilt upstream
    // with security fixes, which is precisely what the scheduled rebuild
    // exists to pick up, and it still has to pass Pin Only and the build
    // and scan job first.
    {
      matchManagers: ["dockerfile"],
      matchUpdateTypes: ["digest"],
      automerge: true,
      addLabels: ["automerge"],
    },

    // The two coding agent CLI versions, the only version pinned software in
    // this image. Everything installed with apt is deliberately unpinned
    // (docs/TOOL_SOURCES.md); these are pinned precisely so this cooldown and
    // `Pin Only` apply to them, because npm has no distribution maintainer
    // standing between a publisher and this build the way Ubuntu does. They
    // take the ordinary patch and minor automerge from the first rule above,
    // which the seven day window and the line by line pin check are what make
    // safe.
    {
      matchManagers: ["custom.regex"],
      matchDatasources: ["npm"],
      groupName: "coding agent CLIs",
      groupSlug: "agent-clis",
      labels: ["dependencies", "tooling"],
    },

    // The github-actions manager extracts more than uses: pins by default:
    // pull-request.yml's python-version: "3.12" passed to
    // actions/setup-python's with: (depType uses-with) is a shape
    // rsync-crypt's own PR #82 proved live there, proposing 3.13 to 3.14
    // with no way to ever merge it. Dependabot's github-actions ecosystem
    // never watched this shape either, it bumped uses: pins only, and
    // the shared pin-only check's rev_pin and action_sha grammars do
    // not match a with: input, so Pin Only would refuse a diff like this
    // and route it to a person every single time upstream Python cuts a
    // release, forever, since the shape never changes. Disabled here so
    // this template, and every repository created from it, stops
    // generating a pull request that can never pass its own required
    // check. matchDepTypes also covers github-runner (a literal runs-on:
    // value) for the same reason, even though nothing here happens to use
    // one today; pre-commit-checklists, pre-commit-checklists-demo and
    // rsync-crypt all carry the identical rule for the identical reason.
    {
      matchManagers: ["github-actions"],
      matchDepTypes: ["github-runner", "uses-with"],
      enabled: false,
    },
  ],
}
