#!/bin/sh
# The OCI runtime podman calls, in place of crun, for every container started
# inside a development container built from this image.
#
# It removes linux.maskedPaths from the container spec and then hands off to
# /usr/bin/crun with its arguments unchanged. Masking a directory means
# mounting a tmpfs over it, and container_engine_t, the confined SELinux
# domain development containers run in, refuses that mount, so without this
# every nested container failed to start ("crun: mount tmpfs to proc/acpi:
# Permission denied"). No podman option avoids it: /sys/kernel stays masked
# even with --security-opt unmask=ALL, and /sys/devices/virtual/powercap is
# listed in the spec twice, so unmasking it removes only one copy.
#
# Nothing is exposed that the development container cannot already see. The
# host still masks the development container itself, and a nested container
# sees the same /proc and /sys that it does (measured 2026-09-15: /proc/acpi
# and /sys/firmware empty in both, /sys/kernel identical in both).
# readonlyPaths are left in place; that domain allows them.
#
# Exit status codes:
#   1    the container spec could not be rewritten
#   any  otherwise, the exit status of /usr/bin/crun itself
#
# REAL_CRUN stands in for /usr/bin/crun, for the tests.

set -o errexit
set -o nounset

bundle=""
previous=""
for argument in "$@"; do
  case "${previous}" in
  --bundle | -b) bundle="${argument}" ;;
  esac
  case "${argument}" in
  --bundle=*) bundle="${argument#--bundle=}" ;;
  esac
  previous="${argument}"
done

if [ -n "${bundle}" ] && [ -f "${bundle}/config.json" ]; then
  if ! jq '.linux.maskedPaths = []' "${bundle}/config.json" >"${bundle}/config.json.unmasked"; then
    echo "crun-without-masked-paths: could not rewrite ${bundle}/config.json" >&2
    rm -f "${bundle}/config.json.unmasked"
    exit 1
  fi
  mv "${bundle}/config.json.unmasked" "${bundle}/config.json"
fi

exec "${REAL_CRUN:-/usr/bin/crun}" "$@"
