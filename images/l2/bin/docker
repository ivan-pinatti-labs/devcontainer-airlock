#!/bin/bash
# `docker` inside L2.
#
# pre-commit hooks of `language: docker_image` (hadolint-docker,
# actionlint-docker) and a few local hooks call `docker run <image> ...`. A
# container cannot start another container from inside L2 on its own, so
# for the images listed in L2_BAKED_IMAGES this runs the binary that image
# would have run, which the L2 Dockerfile copied out of that same official
# image. A baked image at a different version fails with a message saying so.
#
# In an `l2 --engine` run (CONTAINER_HOST is set) everything else is handed
# to the L2 engine through podman-remote, so a hook or a test that builds and
# starts containers of its own can. Without the engine it fails, saying why.
#
# Exit status codes:
#   125  not something this can answer without the engine
#   any  otherwise, the exit status of the tool or of podman-remote

set -o errexit
set -o nounset

original=("$@")

delegate() {
  if [ -n "${CONTAINER_HOST:-}" ]; then
    exec podman-remote "${original[@]}"
  fi
  echo "l2 docker: $*" >&2
  echo "l2 docker: L2 cannot start containers without the engine; see docs/LAYERS.md, \"Container based hooks\"." >&2
  exit 125
}

# pre-commit asks whether the runtime is rootless before deciding whether to
# pass --user. The answer that matches L2 is yes.
if [ "${1:-}" = system ] && [ "${2:-}" = info ] && [ -z "${CONTAINER_HOST:-}" ]; then
  echo '{"SecurityOptions": ["name=rootless"]}'
  exit 0
fi

[ "${1:-}" = run ] || delegate "only 'docker run' is supported here, not '${1:-}'"
shift

workdir=""
mounts=()
while [ $# -gt 0 ]; do
  case "$1" in
    --rm | -i | -t | -it | --interactive | --tty | --init) shift ;;
    -v | --volume) mounts+=("$2"); shift 2 ;;
    --volume=*) mounts+=("${1#--volume=}"); shift ;;
    -w | --workdir) workdir="$2"; shift 2 ;;
    --workdir=*) workdir="${1#--workdir=}"; shift ;;
    -u | --user | -e | --env | --network | --name | --entrypoint | --platform | --security-opt) shift 2 ;;
    --*=*) shift ;;
    -*) delegate "unsupported option $1" ;;
    *) break ;;
  esac
done

[ $# -gt 0 ] || delegate "no image given"
image="$1"
shift

name="${image%@*}"
case "${name##*/}" in
  *:*) tag="${name##*:}"; name="${name%:*}" ;;
  *) tag="" ;;
esac

baked=""
for entry in ${L2_BAKED_IMAGES:-}; do
  if [ "${entry%%=*}" = "${name}" ]; then
    baked="${entry#*=}"
  fi
done
[ -n "${baked}" ] || delegate "image ${name} is not baked into this L2 image"
if [ -n "${tag}" ] && [ "${tag}" != "${baked}" ]; then
  echo "l2 docker: hook asks for ${name}:${tag} but this L2 image carries ${baked}; rebuild L2 with the new version" >&2
  exit 125
fi

# Translate the container's working directory back to the path it was mounted
# from, so relative file arguments resolve the same way.
if [ -n "${workdir}" ]; then
  host_dir=""
  for m in "${mounts[@]}"; do
    src="${m%%:*}"
    rest="${m#*:}"
    dst="${rest%%:*}"
    case "${workdir}" in
      "${dst}") host_dir="${src}" ;;
      "${dst}"/*) host_dir="${src}${workdir#"${dst}"}" ;;
    esac
  done
  [ -n "${host_dir}" ] || delegate "working directory ${workdir} is not inside a mounted volume"
  cd "${host_dir}"
fi

case "${name##*/}" in
  hadolint) exec "$@" ;;
  actionlint) exec actionlint "$@" ;;
  dotenv-linter) exec dotenv-linter "$@" ;;
esac
delegate "no command mapping for ${name}"
