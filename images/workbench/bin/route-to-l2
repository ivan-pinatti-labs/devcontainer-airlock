#!/usr/bin/python3
"""PreToolUse hook: send commands that execute project code to L2.

Installed by the workbench image as a managed hook for both coding agents, so
neither can switch it off. It reads the tool call on stdin. When a shell
command runs a language runtime, a package manager, a test runner or a
script from the working tree, it answers so that the command runs through
`l2` (no network, no credentials, only the working tree) instead of in the
workbench, next to the credentials.

Claude Code: the command is rewritten to `l2 [--net] -- bash -c '<command>'`
and runs without a prompt, since in L2 it can reach nothing worth
protecting. Codex (called with --deny): the command is refused with the
exact `l2` command line to use instead, because Codex does not take a
rewritten command from a hook.

Commands that are not matched (git, gh, ls, cat, podman, l2 itself) are left
alone. A command that both calls l2 and runs project code outside it (say
`pytest; l2 -- pytest`) is refused in either mode: wrapped whole, its l2
would run inside L2, where there is no l2, and left alone, the bare part
would run in the workbench. Run the two as separate commands. So is one that
mixes project code with a part that cannot work in L2 (`curl ... | python3`,
`gh`, `git push`): moved whole, that part would fail there with an error
that points elsewhere. Operators inside quotes do not split a command, so
`l2 -- sh -c 'a && b'` is one l2 call. This is a
policy for the agents, not a security boundary on its own: docs/LAYERS.md
says what is.
"""
# cspell:words commenters
import json
import re
import shlex
import sys

RUNS_CODE = {
    "python", "python3", "pytest", "pip", "pip3", "uv", "uvx", "poetry", "tox", "nox",
    "node", "npm", "npx", "pnpm", "yarn", "bun", "deno", "tsc", "jest", "vitest",
    "go", "cargo", "rustc", "ruff", "mypy", "black", "eslint", "prettier",
    "pre-commit", "shellcheck", "hadolint", "actionlint", "yamllint",
    "markdownlint-cli2", "cspell", "bats",
}
NEEDS_NET = [
    ("pip", "install"), ("pip3", "install"), ("uv", "sync"), ("uv", "pip"), ("uv", "add"),
    ("npm", "install"), ("npm", "ci"), ("npm", "i"), ("npm", "add"), ("pnpm", "install"),
    ("pnpm", "add"), ("yarn", "install"), ("yarn", "add"), ("bun", "install"),
    ("go", "mod"), ("go", "get"), ("go", "install"), ("cargo", "fetch"), ("cargo", "install"),
    ("pre-commit", "install-hooks"), ("pre-commit", "autoupdate"), ("poetry", "install"),
]
ALWAYS_NET = {"npx", "uvx"}
# What L2 never has: the gh broker, the ssh-agent, and a remote for git.
WORKBENCH_ONLY = {"gh", "ssh", "scp", "ssh-add"}
GIT_REMOTE = {"fetch", "pull", "push", "clone", "ls-remote"}
# What L2 has only with --net.
NET_TOOLS = {"curl", "wget"}
ASSIGNMENT = re.compile(r"^[A-Za-z_][A-Za-z0-9_]*=")
# A token made of these alone is an operator that ends a simple command
# (; & && | || ;; newlines, parentheses); one with < or > in it
# is a redirection, which stays with its command.
OPERATOR = set(";&|()\n")


def commands(command):
    """The simple commands in `command`, as word lists, split at operators
    outside quotes: an operator inside a quoted argument (`sh -c 'a && b'`,
    `sed 's|x|y|'`) does not split it. A command the lexer cannot read
    (unbalanced quotes) is split at every operator instead."""
    lexer = shlex.shlex(command.replace("\\\n", " "), posix=True, punctuation_chars=";&|()<>\n")
    lexer.whitespace = " \t\r"
    lexer.whitespace_split = True
    lexer.commenters = ""
    try:
        tokens = list(lexer)
    except ValueError:
        for part in re.split(r"&&|\|\||;|\||\n", command):
            try:
                yield shlex.split(part)
            except ValueError:
                yield part.split()
        return
    words = []
    for token in tokens:
        if token and set(token) <= OPERATOR:
            yield words
            words = []
        else:
            words.append(token)
    yield words


def segments(command):
    for words in commands(command):
        while words and ASSIGNMENT.match(words[0]):
            words = words[1:]
        if words and words[0] in ("sudo", "env", "exec", "time", "nice"):
            words = words[1:]
        if words:
            yield words


def calls_l2(command):
    return any(words[0] == "l2" for words in segments(command))


def classify(command):
    """Whether the command runs project code outside l2, and whether that
    code needs the network. A segment that is an l2 call is already routed."""
    routed = net = False
    for words in segments(command):
        head = words[0].rsplit("/", 1)[-1]
        if words[0] == "l2":
            continue
        script = words[0].startswith(("./", "scripts/", "tests/", "bin/")) or (
            head in ("bash", "sh") and len(words) > 1 and not words[1].startswith("-"))
        if head in RUNS_CODE or script:
            routed = True
            if head in ALWAYS_NET or (len(words) > 1 and (head, words[1]) in NEEDS_NET):
                net = True
            if head in ("python", "python3") and words[1:3] == ["-m", "pip"]:
                net = True
    return routed, net


def git_subcommand(words):
    """git's subcommand, past the global options that take a value."""
    i = 1
    while i < len(words) and words[i].startswith("-"):
        i += 2 if words[i] in ("-C", "-c", "--git-dir", "--work-tree") else 1
    return words[i] if i < len(words) else ""


def outside_l2(command, net):
    """A part of the command that cannot work in the L2 run it would be
    moved to, or None: gh, ssh and git's remote commands need the broker or
    the agent, which L2 never has, and curl and wget need --net."""
    for words in segments(command):
        head = words[0].rsplit("/", 1)[-1]
        if head in WORKBENCH_ONLY:
            return head
        if head == "git" and git_subcommand(words) in GIT_REMOTE:
            return f"git {git_subcommand(words)}"
        if head in NET_TOOLS and not net:
            return head
    return None


def main():
    deny_mode = "--deny" in sys.argv[1:]
    try:
        call = json.load(sys.stdin)
    except ValueError:
        return
    command = (call.get("tool_input") or {}).get("command")
    if not isinstance(command, str) or not command.strip():
        return
    routed, net = classify(command)
    if not routed:
        return
    if calls_l2(command):
        json.dump({"hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": (
                "Calls l2 and also runs project code outside it. Wrapped in l2 whole, "
                "the inner l2 would not be found there; left as is, the rest would run "
                "in the workbench. Run the l2 call and the rest as separate commands.")}},
            sys.stdout)
        return
    part = outside_l2(command, net)
    if part:
        json.dump({"hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": (
                f"Runs project code, which would move the whole command to L2, and `{part}`, "
                "which cannot work there (no network, no gh broker, no ssh-agent). Split the "
                f"`{part}` part from the rest: run it as a command of its own, writing what "
                "the rest needs to a file in the working tree, then run the rest.")}},
            sys.stdout)
        return
    l2 = "l2 --net --" if net else "l2 --"
    words = next(segments(command), [])
    if words and words[0] == "pre-commit" and not net and len(list(segments(command))) == 1:
        # pre-commit gets the protected path check the git hooks use.
        wrapped = "l2-pre-commit " + " ".join(shlex.quote(w) for w in words[1:])
    else:
        wrapped = f"{l2} bash -c {shlex.quote(command)}"
    reason = ("Runs project code, so it goes to L2 (no credentials, "
              + ("network through the egress proxy only)." if net else "no network)."))
    context = ("This command ran in L2, not in the workbench and not on the host: a "
                "throwaway container from the repository's L2 image, with no credentials, "
                + ("network through the egress proxy only, " if net else "no network, ")
                + "and only the working tree mounted. A tool that is not found there is "
                "missing from the repository's L2 image (.devcontainer/l2/Dockerfile).")
    if deny_mode:
        out = {"hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "deny",
            "permissionDecisionReason": f"{reason} Run it as: {wrapped}"}}
    else:
        out = {"hookSpecificOutput": {
            "hookEventName": "PreToolUse",
            "permissionDecision": "allow",
            "permissionDecisionReason": reason,
            "additionalContext": context,
            "updatedInput": dict(call["tool_input"], command=wrapped)}}
    json.dump(out, sys.stdout)


if __name__ == "__main__":
    main()
