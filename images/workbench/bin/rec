#!/bin/bash
: '
  rec for Claude Code voice mode in a workbench: SoX recording from the
  microphone pipe of a voice session instead of an audio device. The
  workbench has no audio device and no way to the host audio server.
  `make claude-voice` has PipeWire, on the host, write the microphone into
  a named pipe for that session (16 kHz, 16 bit, mono) and tells only that
  session where it is, in WORKBENCH_VOICE_MIC. docs/LAYERS.md, "Voice".

  Takes what SoX rec takes after its input: the output format, the output
  file and the effects, as Claude Code passes them. Without a voice session
  it fails, `rec --version` included, so Claude Code says there is no
  microphone rather than recording nothing.
'
set -o errexit
set -o nounset

mic="${WORKBENCH_VOICE_MIC:-}"
case "${mic}" in
  /run/workbench-voice/*) ;;
  *)
    echo "rec: no microphone in this session; start it with make claude-voice (docs/LAYERS.md, Voice)" >&2
    exit 1 ;;
esac
if [ ! -p "${mic}" ]; then
  echo "rec: the microphone pipe ${mic} is gone; its voice session has ended" >&2
  exit 1
fi
case "${1:-}" in
  --version | -h | --help) exec /usr/bin/sox "$@" ;;
esac
# Whatever PipeWire wrote while nothing was reading (the pipe's buffer,
# about two seconds) is old; drop it so a recording starts close to now. A
# read that does not wait takes everything there up to its size, and fails
# once the pipe is empty; a few passes catch what PipeWire adds meanwhile.
# It is not an exact boundary, since PipeWire keeps writing.
for _ in 1 2 3 4 5 6 7 8; do
  dd if="${mic}" iflag=nonblock of=/dev/null bs=1048576 count=1 status=none 2>/dev/null || break
done
exec /usr/bin/sox -t raw -r 16000 -e signed -b 16 -c 1 "${mic}" "$@"
