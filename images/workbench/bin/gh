#!/usr/bin/python3
"""gh, answered by the gh broker.

The workbench holds no GitHub token. This sends the command line and the
current directory to the gh broker over a unix socket; the broker runs the
real gh with the token if the command is on its allowlist, and returns the
output and exit status. See docs/LAYERS.md, "GitHub access".

Interactive prompts are not available: pass the flags a prompt would ask for
(--title, --body or --body-file, --head, --base).

The broker never reads a file named on the command line: it would read it
there, beside the token. So a --body-file (or -F) path is read here, in the
workbench, and sent as the body on stdin (--body-file -). Not for gh api,
where -F is a field.

Exit status codes:
  1    a --body-file path could not be read
  124  no reply from the broker within TIMEOUT seconds
  126  the broker refused the command (the message says why)
  127  the broker is not reachable, or the connection to it failed
  any  otherwise, the exit status of gh itself
"""
import json
import os
import socket
import sys


def inline_body_file(argv):
    """argv with a --body-file or -F path replaced by `--body-file -`, and
    that file's text, or None when no path was given."""
    if not argv or argv[0] == "api":
        return argv, None
    out, body, i = [], None, 0
    while i < len(argv):
        a, path = argv[i], None
        if a in ("--body-file", "-F") and i + 1 < len(argv):
            path, i = argv[i + 1], i + 2
        elif a.startswith("--body-file="):
            path, i = a.split("=", 1)[1], i + 1
        elif a.startswith("-F") and len(a) > 2:
            path, i = a[2:], i + 1
        else:
            out.append(a)
            i += 1
            continue
        if path != "-":
            try:
                with open(path, encoding="utf-8") as f:
                    body = f.read()
            except OSError as e:
                sys.stderr.write(f"gh: cannot read {path} ({e.strerror})\n")
                sys.exit(1)
        out += ["--body-file", "-"]
    return out, body


def reads_stdin(argv):
    """Whether gh would read its standard input for this command line: a body
    or an api input given as `-`, or an api field read from `@-`."""
    for i, a in enumerate(argv):
        nxt = argv[i + 1] if i + 1 < len(argv) else ""
        if a in ("--body-file", "--input") and nxt == "-":
            return True
        if a in ("--body-file=-", "--input=-") or a.endswith("=@-"):
            return True
        if a in ("-F", "--field", "-f", "--raw-field") and nxt.endswith("=@-"):
            return True
    return False


# The broker kills gh after 300 s; a reply that has not come some time after
# that is not coming, so the call fails instead of waiting for ever.
TIMEOUT = 330

argv, body = inline_body_file(sys.argv[1:])
# Standard input is read only when the command takes it, and before the
# broker is contacted. Read unconditionally, an input that never ends (a
# pipe left open by whatever started this) blocked the call before it was
# sent, with nothing in the broker's log to show it (#81).
if body is not None:
    stdin = body
elif reads_stdin(argv):
    stdin = sys.stdin.read()
else:
    stdin = ""
path = os.environ.get("GH_BROKER_SOCK", "/run/gh-broker/gh.sock")
try:
    s = socket.socket(socket.AF_UNIX)
    s.settimeout(TIMEOUT)
    s.connect(path)
except OSError as e:
    sys.stderr.write(
        f"gh: the gh broker is not reachable at {path} ({e.strerror}).\n"
        "gh: start the helpers on the host: host/workbench up\n")
    sys.exit(127)
try:
    s.sendall((json.dumps({"argv": argv, "cwd": os.getcwd(), "stdin": stdin}) + "\n").encode())
    s.shutdown(socket.SHUT_WR)
    raw = b"".join(iter(lambda: s.recv(65536), b""))
except socket.timeout:
    sys.stderr.write(f"gh: no reply from the gh broker after {TIMEOUT}s\n")
    sys.exit(124)
except OSError as e:
    sys.stderr.write(f"gh: the connection to the gh broker failed ({e.strerror})\n")
    sys.exit(127)
reply = json.loads(raw or b'{"rc":1,"out":"","err":"gh: empty reply from broker\\n"}')
sys.stdout.write(reply["out"])
sys.stderr.write(reply["err"])
sys.exit(reply["rc"])
