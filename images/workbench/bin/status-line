#!/bin/bash
: '
  status-line

  Claude Code status line (managed settings): the workbench this session
  runs in, so a glance tells one terminal from another. Prints, from
  AIRLOCK_WORKBENCH and the JSON Claude Code passes on stdin:

    workbench-claude-s-brave-otter | ~/src/pdf-sign-linux/.../brave-otter (feat/x) | Opus, high effort

  It never fails the status line: anything missing is left out.
'
set -u

input="$(cat)"
dir="$(jq -r '.workspace.current_dir // .cwd // empty' <<<"${input}" 2>/dev/null)"
model="$(jq -r '.model.display_name // empty' <<<"${input}" 2>/dev/null)"
effort="$(jq -r '.effort.level // empty' <<<"${input}" 2>/dev/null)"

parts=("${AIRLOCK_WORKBENCH:-workbench}")
if [ -n "${dir}" ]; then
  # The folder, with the home folder as ~ and a session clone's
  # .claude/worktrees/ cut to .../, then the branch when it is a repository.
  where="$(sed -E 's#^/home/[^/]+#~#; s#/\.claude/worktrees/#/.../#' <<<"${dir}")"
  branch="$(git -C "${dir}" branch --show-current 2>/dev/null)"
  parts+=("${where}${branch:+ (${branch})}")
fi
[ -z "${model}" ] || parts+=("${model}${effort:+, ${effort} effort}")

out="${parts[0]}"
for p in "${parts[@]:1}"; do out+=" | ${p}"; done
printf '%s\n' "${out}"
