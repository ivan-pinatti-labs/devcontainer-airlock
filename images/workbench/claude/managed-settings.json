      "Bash(podman network reload:*)",
      "Bash(podman network update:*)",
      "Bash(podman volume rm:*)",
      "Bash(podman volume prune:*)",
      "Bash(podman volume import:*)",
      "Bash(podman volume export:*)",
      "Bash(podman volume mount:*)",
      "Bash(podman volume reload:*)",
      "Bash(podman system prune:*)",
      "Bash(podman system reset:*)",
      "Bash(podman system migrate:*)",
      "Bash(podman system renumber:*)",
      "Bash(podman system service:*)",
      "Bash(podman system connection:*)",
      "Bash(podman -*)"
    ],
    "deny": ["Read(/home/dev/.claude/.credentials.json)"]
  },
  "sandbox": {
    "enabled": true,
    "enableWeakerNestedSandbox": true,
    "excludedCommands": ["l2 *", "git *", "podman *", "gh *", "ssh-add -l"]
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  }
}
