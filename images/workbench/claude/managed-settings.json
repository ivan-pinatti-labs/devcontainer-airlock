{
  "allowManagedHooksOnly": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/libexec/workbench/route-to-l2"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(podman ps)",
      "Bash(podman ps *)",
      "Bash(podman images)",
      "Bash(podman images *)",
      "Bash(podman inspect *)",
      "Bash(podman logs *)",
      "Bash(podman top *)",
      "Bash(podman port *)",
      "Bash(podman stats *)",
      "Bash(podman history *)",
      "Bash(podman diff *)",
      "Bash(podman info)",
      "Bash(podman info *)",
      "Bash(podman version)",
      "Bash(podman version *)",
      "Bash(podman search *)",
      "Bash(podman pull *)",
      "Bash(podman container ls)",
      "Bash(podman container ls *)",
      "Bash(podman container list *)",
      "Bash(podman container inspect *)",
      "Bash(podman container exists *)",
      "Bash(podman container logs *)",
      "Bash(podman image ls)",
      "Bash(podman image ls *)",
      "Bash(podman image list *)",
      "Bash(podman image inspect *)",
      "Bash(podman image exists *)",
      "Bash(podman image history *)",
      "Bash(podman image tree *)",
      "Bash(podman network ls)",
      "Bash(podman network ls *)",
      "Bash(podman network list *)",
      "Bash(podman network inspect *)",
      "Bash(podman network exists *)",
      "Bash(podman network create *)",
      "Bash(podman volume ls)",
      "Bash(podman volume ls *)",
      "Bash(podman volume list *)",
      "Bash(podman volume inspect *)",
      "Bash(podman volume exists *)",
      "Bash(podman volume create *)",
      "Bash(podman system df)",
      "Bash(podman system df *)",
      "Bash(podman system info *)"
    ],
    "ask": [
      "Bash(l2 --image:*)",
      "Bash(podman run:*)",
      "Bash(podman exec:*)",
      "Bash(podman create:*)",
      "Bash(podman start:*)",
      "Bash(podman restart:*)",
      "Bash(podman attach:*)",
      "Bash(podman build:*)",
      "Bash(podman buildx:*)",
      "Bash(podman commit:*)",
      "Bash(podman cp:*)",
      "Bash(podman mount:*)",
      "Bash(podman unshare:*)",
      "Bash(podman play:*)",
      "Bash(podman kube:*)",
      "Bash(podman compose:*)",
      "Bash(podman pod:*)",
      "Bash(podman healthcheck:*)",
      "Bash(podman update:*)",
      "Bash(podman import:*)",
      "Bash(podman load:*)",
      "Bash(podman export:*)",
      "Bash(podman save:*)",
      "Bash(podman push:*)",
      "Bash(podman login:*)",
      "Bash(podman secret:*)",
      "Bash(podman manifest:*)",
      "Bash(podman machine:*)",
      "Bash(podman farm:*)",
      "Bash(podman quadlet:*)",
      "Bash(podman generate:*)",
      "Bash(podman auto-update:*)",
      "Bash(podman rm:*)",
      "Bash(podman rmi:*)",
      "Bash(podman kill:*)",
      "Bash(podman stop:*)",
      "Bash(podman pause:*)",
      "Bash(podman unpause:*)",
      "Bash(podman init:*)",
      "Bash(podman rename:*)",
      "Bash(podman untag:*)",
