{
  "allowManagedHooksOnly": true,
  "permissions": {
    "disableBypassPermissionsMode": "disable"
  },
  "statusLine": {
    "type": "command",
    "command": "/usr/local/libexec/workbench/status-line",
    "padding": 0
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/libexec/workbench/conversation-note"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/local/libexec/workbench/route-to-l2"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "enableWeakerNestedSandbox": true,
    "excludedCommands": [
      "l2 *",
      "git *",
      "podman *",
      "gh *",
      "ssh-add -l",
      "airlock-worktree *"
    ]
  },
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  }
}
