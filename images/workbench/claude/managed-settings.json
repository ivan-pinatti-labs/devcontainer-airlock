      "Bash(podman container exec:*)",
      "Bash(podman container create:*)",
      "Bash(podman container start:*)",
      "Bash(podman container restart:*)",
      "Bash(podman container attach:*)",
      "Bash(podman container init:*)",
      "Bash(podman container clone:*)",
      "Bash(podman container commit:*)",
      "Bash(podman container cp:*)",
      "Bash(podman container mount:*)",
      "Bash(podman container export:*)",
      "Bash(podman container checkpoint:*)",
      "Bash(podman container restore:*)",
      "Bash(podman container runlabel:*)",
      "Bash(podman container update:*)",
      "Bash(podman container rename:*)",
      "Bash(podman container rm:*)",
      "Bash(podman container kill:*)",
      "Bash(podman container stop:*)",
      "Bash(podman container pause:*)",
      "Bash(podman container prune:*)",
      "Bash(podman container cleanup:*)",
      "Bash(podman image build:*)",
      "Bash(podman image rm:*)",
      "Bash(podman image prune:*)",
      "Bash(podman image load:*)",
