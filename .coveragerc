# Coverage settings for the Python this repository writes. Read by
# `make coverage`, which .github/workflows/sonarqube.yml and the
# `coverage` pre-push hook in .pre-commit-config.yaml both run.
#
# 100%, lines and branches both. SonarQube Cloud's Free plan quality gate is
# fixed at 80% on new code and cannot be raised, so this is what holds the
# higher bar. Branches too, so every `if` has been seen going both ways, not
# only reached. Most of the Python here is a script without an extension,
# which coverage.py measures once a test runs it but never finds on its own;
# the Makefile's PYTHON_SOURCES names every file, and scripts/kcov_to_sonar.py
# fails the run when one is missing from the report.
[run]
# Paths in coverage.xml relative to the repository root, which is what
# SonarQube Cloud resolves them against; the tests run in a container whose
# copy of the tree lives elsewhere.
relative_files = true
source = .
branch = true
# The tests themselves, including the two the gh-broker and mirror-gate image
# builds run.
omit =
    tests/*
    */test_*.py

[report]
fail_under = 100
show_missing = true
skip_covered = true
# The one line a test cannot reach without running the file as a program.
# Everything it calls is main(), which the tests drive directly. coverage.py
# excludes the whole block under it, so that block holds one call into
# main() and nothing else; tests/test_main_guards.py holds every Python
# source to that.
exclude_also =
    if __name__ == .__main__.:
